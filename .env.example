# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
#
# ACCESS: set one of these. Without either the container refuses to start,
# unless STACK_OPEN=1 (a private LAN only: anyone who can reach the port could
# use it). NEVER expose port 8790 to the internet without a token.
#
# A long random string, e.g. from: openssl rand -hex 32
# The app sends it as "Authorization: Bearer <token>".
STACK_TOKEN=
# Or: short-lived signed tokens from the Lithos server (it holds the same key).
STACK_SIGNING_KEY=
# STACK_OPEN=1

# Languages people LISTEN in (voices are fetched for these) and may SPEAK.
# All 24 need a 48 GB GPU; see the README for what fits in 32 GB.
LANGS=en,es,fr,pt,de,ru,uk,zh,ja,km,lo,ht,ar,hi,vi,ko,tl,fa,id,tr,bn,ur,it,sw,ro
SRCS=en,es,fr,pt,de,ru,uk,it,zh,ja,ko,sw,km,lo,ht,ar,hi,vi,tl,fa,id,tr,bn,ur,ro

# nonprofit: Meta MMS voices (CC-BY-NC, non-commercial) for Haitian Creole and as
#            the Khmer/Lao/Tagalog fallback. commercial: no non-commercial weights.
EDITION=nonprofit

# 7b, or 3b to fit a 32 GB card (weaker Swahili and Haitian Creole).
MADLAD=7b
# 1 = start the VoxCPM2 voice service (Khmer, Lao, Tagalog; ~7 GB of GPU memory).
VOXCPM=1

# Host port the stack is published on.
STACK_PORT=8790
