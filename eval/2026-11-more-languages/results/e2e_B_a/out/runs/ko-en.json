24000,"on":0,"off":1090},{"kind":"audio","t":61517.936996000004,"samples":7392,"rate":24000},{"kind":"input","t":62955.170266,"text":"이리저리 뒤섞습니다."},{"kind":"text","t":63203.255319,"text":"shuffle them around."},{"kind":"audio","t":63294.177026000005,"samples":32768,"rate":24000,"on":370,"off":1360},{"kind":"audio","t":63295.639792,"samples":15832,"rate":24000,"on":0,"off":110},{"kind":"input","t":69645.697162,"text":"벌레라는 용어는 곤충학자들이 이러한 종류의 곤충을 격식을 갖추어 부르는 말이다."},{"kind":"text","t":70303.384791,"text":"The term \"bug\" is what entomologists formally call these types of insects."},{"kind":"audio","t":70400.122202,"samples":32768,"rate":24000,"on":390,"off":1220},{"kind":"audio","t":70405.29141600001,"samples":32768,"rate":24000,"on":300,"off":1360},{"kind":"audio","t":70410.75473500001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":70415.457486,"samples":31296,"rate":24000,"on":0,"off":790},{"kind":"input","t":78549.857452,"text":"첫째 대부분의 기수들은 힐이 있고 밑창이 매끈하고 좁은 승마화를 신습니다."},{"kind":"text","t":79292.220722,"text":"First, most jockeys wear riding boots that have heels and smooth, narrow soles."},{"kind":"audio","t":79494.447058,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":79499.958726,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79505.04391200001,"samples":32768,"rate":24000,"on":0,"off":1090},{"kind":"audio","t":79510.251715,"samples":32768,"rate":24000,"on":140,"off":1170},{"kind":"audio","t":79510.897194,"samples":8728,"rate":24000},{"kind":"input","t":89502.83981800001,"text":"10월에 시작된 광범위한 반정권 프로테스트에 대한 멀토이의 대응 차원에서 위원회가 마련되었습니다."},{"kind":"text","t":90454.490006,"text":"A commission was established as part of Multoe's response to the widespread anti-government protests that began in October."},{"kind":"audio","t":90575.356436,"samples":32768,"rate":24000,"on":400,"off":1330},{"kind":"audio","t":90580.724266,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":90585.953469,"samples":32768,"rate":24000,"on":0,"off":1080},{"kind":"audio","t":90591.35112,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":90596.610402,"samples":32768,"rate":24000,"on":0,"off":1120},{"kind":"audio","t":90601.905094,"samples":32768,"rate":24000,"on":140,"off":1360},{"kind":"audio","t":90604.47129100001,"samples":19392,"rate":24000,"on":0,"off":170},{"kind":"input","t":95370.267577,"text":"소방 구조대원들이 결국 오후 11시 35분까지 불을 껐다."},{"kind":"text","t":96032.39884200001,"text":"Firefighters finally put out the fire by 11:35 PM."},{"kind":"audio","t":96143.170369,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":96148.577949,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":96153.815912,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":96158.291428,"samples":30096,"rate":24000,"on":0,"off":590},{"kind":"input","t":102070.97638400001,"text":"대서양 허리케인의 열 번째 폭풍인 아열대 폭풍 제리가"},{"kind":"text","t":102666.726603,"text":"Subtropical Storm Jerry, the tenth storm of the Atlantic hurricane season,"},{"kind":"audio","t":102777.92486300001,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":102783.332584,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102788.715924,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102794.301061,"samples":32768,"rate":24000,"on":0,"off":970},{"kind":"audio","t":102794.465958,"samples":4528,"rate":24000},{"kind":"input","t":105767.15092500001,"text":"오늘 대서양에서 생성되었습니다."},{"kind":"text","t":106110.861287,"text":"formed in the Atlantic today."},{"kind":"audio","t":106248.3203,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":106252.187736,"samples":29032,"rate":24000,"on":0,"off":640},{"kind":"input","t":111550.171898,"text":"그것은 기차와 자동차 및 여러 교통수단을 가져다 주었습니다."},{"kind":"text","t":112061.749708,"text":"It brought trains, cars, and various means of transportation."},{"kind":"audio","t":112171.664349,"samples":32768,"rate":24000,"on":410,"off":1350},{"kind":"audio","t":112176.961971,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":112182.385951,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":112184.380587,"samples":16896,"rate":24000,"on":0,"off":80},{"kind":"input","t":121195.824833,"text":"사치의 진원지라는 명성은 서기 400년경에 시작하여 서기 1100년경까지 이어졌습니다."},{"kind":"text","t":122350.591642,"text":"Its reputation as the epicenter of luxury began around 400 AD and continued until around 1100 AD."},{"kind":"audio","t":122522.432153,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":122527.828424,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":122532.944928,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":122538.297569,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":122543.499883,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":122548.834524,"samples":32768,"rate":24000,"on":460,"off":1360},{"kind":"audio","t":122553.67856300001,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":122554.50396,"samples":14224,"rate":24000},{"kind":"input","t":128851.312476,"text":"달의 표면은 돌과 먼지로 이루어져 있는데 달의 바깥층은 크러스트라고 불린다."},{"kind":"text","t":129767.083481,"text":"The surface of the moon consists of rock and dust, and the outer layer of the moon is called the crust."},{"kind":"audio","t":129882.64552800001,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":129887.87264100001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":129892.954687,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":129898.319618,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":129903.68200800002,"samples":32768,"rate":24000,"on":0,"off":820},{"kind":"audio","t":129903.99742300001,"samples":1760,"rate":24000},{"kind":"input","t":138866.0328,"text":"미국 공병대는 시간당 6인치의 강우량이 기파손된 제방을 무너뜨릴 수 있다고 추정했다."},{"kind":"text","t":139856.597601,"text":"The U.S. Army Corps of Engineers estimated that rainfall of 6 inches per hour could collapse the damaged levee."},{"kind":"audio","t":139976.550516,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":139981.750029,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":139987.032411,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":139992.251525,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":139997.293541,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140002.89917699998,"samples":32768,"rate":24000,"on":0,"off":960},{"kind":"audio","t":140003.013456,"samples":5592,"rate":24000},{"kind":"input","t":147111.541018,"text":"특히 미세한 표정을 정확하게 해석해서 사람이 거짓말을 하고 있는지 여부를 검출할 수 있다고 주장합니다."},{"kind":"text","t":147983.702168,"text":"In particular, it is claimed that it can detect whether a person is lying by accurately interpreting micro-expressions."},{"kind":"audio","t":148101.045896,"samples":32768,"rate":24000,"on":420,"off":1230},{"kind":"audio","t":148106.087073,"samples":32768,"rate":24000,"on":320,"off":1360},{"kind":"audio","t":148111.351975,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":148116.58415799998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":148121.836081,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":148125.919593,"samples":29360,"rate":24000,"on":0,"off":650},{"kind":"input","t":152952.83635199998,"text":"구조물을 긁거나 낙서해서 현장을 더럽히지 마시오."},{"kind":"text","t":153588.91001,"text":"Do not deface the site by scratching or scribbling on the structures."},{"kind":"audio","t":153696.233805,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":153697.568782,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":153699.104807,"samples":32768,"rate":24000,"on":0,"off":1300},{"kind":"audio","t":153699.444371,"samples":12096,"rate":24000},{"kind":"input","t":161497.385858,"text":"호랑이의 포효는 사자의 우렁찬 포효와는 다르지만"},{"kind":"text","t":162157.392032,"text":"Although a tiger's roar is different from a lion's powerful roar,"},{"kind":"audio","t":162255.161057,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":162260.407511,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":162265.562996,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":162266.708587,"samples":12096,"rate":24000},{"kind":"input","t":166523.53405,"text":"으르렁거리며 소리지르는 단어의 문장과 비슷합니다."},{"kind":"text","t":167185.958835,"text":"it is similar to a sentence of words that growl and shout."},{"kind":"audio","t":167382.780653,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":167387.742442,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":167392.166719,"samples":31664,"rate":24000,"on":0,"off":640},{"kind":"input","t":175241.230236,"text":"20세기의 연구에 따르면 숨겨지거나 나타나는 두 가지 유전적 변이 집단이 있습니다."},{"kind":"text","t":176178.941261,"text":"According to 20th-century research, there are two groups of genetic variants, some hidden and some apparent."},{"kind":"audio","t":176436.66429,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":176441.92474299998,"samples":32768,"rate":24000,"on":0,"off":1110},{"kind":"audio","t":176447.18141699999,"samples":32768,"rate":24000,"on":170,"off":1360},{"kind":"audio","t":176452.669177,"samples":32768,"rate":24000,"on":0,"off":1030},{"kind":"audio","t":176458.003129,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":176460.526938,"samples":19760,"rate":24000,"on":0,"off":140},{"kind":"close","t":186805.39450899998,"code":1005}]}