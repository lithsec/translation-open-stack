127,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":53466.377361,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":53468.3291,"samples":32768,"rate":24000,"on":0,"off":880},{"kind":"audio","t":53468.607126,"samples":288,"rate":24000},{"kind":"input","t":58775.221338,"text":"Segregation and recombination shuffle variation back and forth between the two pools."},{"kind":"text","t":61201.830546,"text":"अलगाव एवं पुनर्संयोजन, दोनों समूहों के बीच विविधता को आगे-पीछे ले जाते हैं।"},{"kind":"audio","t":61296.615267,"samples":32768,"rate":24000,"on":530,"off":1360},{"kind":"audio","t":61301.920073,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":61306.737368,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":61311.67634,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":61316.285388000004,"samples":32768,"rate":24000,"on":0,"off":1100},{"kind":"audio","t":61316.582003,"samples":5960,"rate":24000},{"kind":"input","t":61491.041712,"text":"with each generation."},{"kind":"text","t":62048.588403,"text":"हर पीढ़ी के साथ।"},{"kind":"audio","t":62135.721234000004,"samples":32768,"rate":24000,"on":460,"off":1360},{"kind":"audio","t":62136.408663,"samples":21832,"rate":24000,"on":0,"off":520},{"kind":"input","t":66505.19818899999,"text":"The term bug is used by entomologists in a formal sense for this group of insects."},{"kind":"text","t":69045.73131599999,"text":"कीटविज्ञानी इस कीड़ों के समूह के लिए औपचारिक अर्थ में “बग” शब्द का उपयोग करते हैं।"},{"kind":"audio","t":69133.36038999999,"samples":32768,"rate":24000,"on":500,"off":1340},{"kind":"audio","t":69138.681566,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":69143.71473699999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69149.062543,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69153.63947099999,"samples":32768,"rate":24000,"on":0,"off":1120},{"kind":"audio","t":69153.926836,"samples":7160,"rate":24000},{"kind":"input","t":74685.79999,"text":"First, most riders wearing riding boots with a heel and a smooth, quite narrow sole."},{"kind":"text","t":78106.178665,"text":"सबसे पहले, अधिकांश सवार ऐसे घुड़सवारी जूते पहनते हैं जिनकी एड़ी होती है एवं तल चिकना एवं काफी संकीर्ण होता है।"},{"kind":"audio","t":78213.445429,"samples":32768,"rate":24000,"on":510,"off":1330},{"kind":"audio","t":78218.41080099999,"samples":32768,"rate":24000,"on":150,"off":1220},{"kind":"audio","t":78223.730998,"samples":32768,"rate":24000,"on":50,"off":1350},{"kind":"audio","t":78228.87366699999,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":78234.038066,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":78239.24132399999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":78243.85540199999,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":78244.34935399999,"samples":16024,"rate":24000,"on":0,"off":150},{"kind":"input","t":83903.594976,"text":"The commission was Martelli's response to widespread anti-regime protests that started in October."},{"kind":"text","t":86992.517278,"text":"यह आयोग, अक्टूबर में शुरू हुए व्यापक विरोध प्रदर्शनों के जवाब में मार्टेली द्वारा गठित किया गया था।"},{"kind":"audio","t":87095.51123999999,"samples":32768,"rate":24000,"on":540,"off":1290},{"kind":"audio","t":87100.38752399999,"samples":32768,"rate":24000,"on":170,"off":1360},{"kind":"audio","t":87105.124119,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":87110.53375399999,"samples":32768,"rate":24000,"on":40,"off":1360},{"kind":"audio","t":87115.65913399999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":87120.47405799999,"samples":32768,"rate":24000,"on":0,"off":1150},{"kind":"audio","t":87120.735154,"samples":7392,"rate":24000},{"kind":"input","t":91128.49449099999,"text":"Fire rescue crews eventually doused the fire by 11.35pm."},{"kind":"text","t":93320.61682299999,"text