000,"on":0,"off":1360},{"kind":"audio","t":85188.38278900001,"samples":32768,"rate":24000,"on":0,"off":1010},{"kind":"audio","t":85193.66142100001,"samples":32768,"rate":24000,"on":80,"off":1360},{"kind":"audio","t":85199.477193,"samples":32768,"rate":24000,"on":0,"off":940},{"kind":"audio","t":85199.628901,"samples":5592,"rate":24000},{"kind":"input","t":86471.253972,"text":"یخ یا دمای انجماد را در نظر بگیرد"},{"kind":"text","t":86752.982577,"text":"ice or freezing temperatures."},{"kind":"audio","t":86863.007071,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":86867.15748200001,"samples":30832,"rate":24000,"on":0,"off":740},{"kind":"input","t":87347.001114,"text":"نهاية الدرس"},{"kind":"text","t":87533.29832900001,"text":"End of lesson"},{"kind":"audio","t":87646.99810200001,"samples":32768,"rate":24000,"on":410,"off":1300},{"kind":"audio","t":87647.484954,"samples":10432,"rate":24000},{"kind":"input","t":101980.90510500001,"text":"تفکیک و ترکیب مجدد اختلاف بین دو استخر با هر نصب را به سمت جلو و عقب بر میزند"},{"kind":"text","t":102690.51624200001,"text":"Separating and recombining the difference between the two pools moves each installation forward and backward."},{"kind":"audio","t":102813.948352,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":102818.89465900001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102823.91721500001,"samples":32768,"rate":24000,"on":20,"off":1050},{"kind":"audio","t":102829.217466,"samples":32768,"rate":24000,"on":150,"off":1360},{"kind":"audio","t":102834.561766,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102836.904557,"samples":18560,"rate":24000,"on":0,"off":60},{"kind":"input","t":113374.700801,"text":"حشر شناسان از اصطلاح ساس به مفهومی رسمی برای اشاره به این گروه از حشرات استفاده میکنند"},{"kind":"text","t":114244.58941,"text":"Entomologists use the term \"Sass\" as a formal concept to refer to this group of insects."},{"kind":"audio","t":1143