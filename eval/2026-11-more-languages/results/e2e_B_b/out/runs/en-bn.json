64,"samples":32768,"rate":24000,"on":290,"off":1160},{"kind":"audio","t":46704.892741999996,"samples":32768,"rate":24000,"on":210,"off":1250},{"kind":"audio","t":46710.004875,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":46712.792906999995,"samples":17275,"rate":24000,"on":0,"off":330},{"kind":"input","t":58075.881573,"text":"The hospital has followed protocol for infection control, including separating the patient from others to prevent possible infection of others."},{"kind":"text","t":59033.693817,"text":"অন্যদের সম্ভাব্য সংক্রমণ রোধ করতে রোগীকে অন্যদের থেকে আলাদা রাখা সহ সংক্রমণ নিয়ন্ত্রণের প্রোটোকল হাসপাতালটি অনুসরণ করেছে।"},{"kind":"audio","t":59175.285491999995,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":59180.448474,"samples":32768,"rate":24000,"on":0,"off":1020},{"kind":"audio","t":59185.798001999996,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59191.137741,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59196.477848999995,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59200.100347,"samples":23962,"rate":24000,"on":0,"off":680},{"kind":"input","t":68179.612199,"text":"The work done was mostly theoretical, but the program was written to simulate observations made of the Sagittarius galaxy."},{"kind":"text","t":69310.786734,"text":"সম্পাদিত কাজটি মূলত তাত্ত্বিক ছিল, তবে প্রোগ্রামটি সেজিতেরিয়াস গ্যালাক্সির পর্যবেক্ষণের অনুকরণ করার জন্য লেখা হয়েছিল।"},{"kind":"audio","t":69445.294281,"samples":32768,"rate":24000,"on":170,"off":1340},{"kind":"audio","t":69450.142878,"samples":32768,"rate":24000,"on":20,"off":1050},{"kind":"audio","t":69455.616914,"samples":32768,"rate":24000,"on":150,"off":1360},{"kind":"audio","t":69461.040761,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69466.403839,"samples":32768,"rate":24000,"on":150,"off":1360},{"kind":"audio","t":69468.624291,"samples":15325,"rate":24000,"on":0,"off":330},{"kind":"input","t":78310.314793,"text":"Barcelona's official languages are Catalan and Spanish. About half prefer to speak Catalan, a vast majority understands it, and virtually everyone knows Spanish."},{"kind":"text","t":79345.007491,"text":"বার্সেলোনার সরকারি ভাষা হলো কাতালান এবং স্প্যানিশ। প্রায় অর্ধেক মানুষ কাতালান ভাষায় কথা বলতে পছন্দ করেন, বিশাল সংখ্যাগরিষ্ঠ অংশ এটি বোঝেন এবং কার্যত সবাই স্প্যানিশ জানেন।"},{"kind":"audio","t":79551.638832,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":79552.92155,"samples":32768,"rate":24000,"on":0,"off":1130},{"kind":"audio","t":79554.396265,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":79556.174464,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79557.669829,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79559.264581,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79560.89722299999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79562.461037,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79563.41336,"samples":23461,"rate":24000,"on":0,"off":670},{"kind":"input","t":83792.573205,"text":"In some areas, boiling water for a minute is enough and other several minutes are needed."},{"kind":"text","t":84503.838302,"text":"কিছু কিছু এলাকায় এক মিনিট জল ফোটালেই যথেষ্ট এবং অন্যান্য জায়গায় বেশ কয়েক মিনিট প্রয়োজন।"},{"kind":"audio","t":84602.862526,"samples":32768,"rate":24000,"on":280,"off":1360},{"kind":"audio","t":84607.991468,"samples":32768,"rate":24000,"on":40,"off":1320},{"kind":"audio","t":84613.194759,"samples":32768,"rate":24000,"on":150,"off":1360},{"kind":"audio","t":84617.152601,"samples":25690,"rate":24000,"on":0,"off":790},{"kind":"input","t":89859.332175,"text":"Plants look their best when in a natural environment, so resist the temptation to remove even just one stem."},{"kind":"text","t":91030.264109,"text":"গাছগুলো প্রাকৃতিক পরিবেশে সবচেয়ে সুন্দর দেখায়, তাই একটি ডালও ছেঁটে ফেলার প্রলোভনটি নিয়ন্ত্রণ করুন।"},{"kind":"audio","t":91147.252676,"samples":32768,"rate":24000,"on":220,"off":1350},{"kind":"audio","t":91148.569353,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":91149.91996,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91151.549562,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91152.739032,"samples":28031,"rate":24000,"on":0,"off":880},{"kind":"input","t":97828.958993,"text":"During the 1920s, the prevailing attitudes of most citizens and nations was that of pacifism and isolation."},{"kind":"text","t":98712.53378,"text":"১৯২০-এর দশকে, অধিকাংশ নাগরিক এবং রাষ্ট্রের প্রচলিত মনোভাব ছিল শান্তিবাদ এবং বিচ্ছিন্নতাবাদের।"},{"kind":"audio","t":98852.56084199999,"samples":32768,"rate":24000,"on":220,"off":1360},{"kind":"audio","t":98857.559826,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98862.800887,"samples":32768,"rate":24000,"on":0,"off":990},{"kind":"audio","t":98868.464169,"samples":32768,"rate":24000,"on":70,"off":1110},{"kind":"audio","t":98874.008875,"samples":32768,"rate":24000,"on":80,"off":1360},{"kind":"audio","t":98877.000273,"samples":20061,"rate":24000,"on":0,"off":370},{"kind":"input","t":103528.18304999999,"text":"Masa Serif was the apex predator of its time, so it feared nothing except other Mosul"},{"kind":"text","t":104450.518132,"text":"মাস সেরিফ ছিল তার সময়ের সর্বোচ্চ শিকারি, তাই সে অন্য মাসুল ছাড়া আর কাউকে ভয় পেত না।"},{"kind":"audio","t":104556.700534,"samples":32768,"rate":24000,"on":280,"off":1360},{"kind":"audio","t":104561.930694,"samples":32768,"rate":24000,"on":0,"off":1160},{"kind":"audio","t":104567.280342,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":104572.527262,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":104573.376298,"samples":7690,"rate":24000,"on":0,"off":30},{"kind":"input","t":113138.836481,"text":"Since the foundation of Asuncion in 1537, Paraguay has managed to keep a lot of its indigenous character and identity."},{"kind":"text","t":114274.378942,"text":"১৫৩৭ সালে আসুন্সিয়ন প্রতিষ্ঠার পর থেকে, প্যারাগুয়ে তার আদিবাসী বৈশিষ্ট্য এবং পরিচয় অনেকাংশেই ধরে রাখতে সক্ষম হয়েছে।"},{"kind":"audio","t":114431.53487999999,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":114436.450496,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":114441.843544,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114447.386839,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114452.859435,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114458.330741,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114459.134047,"samples":7355,"rate":24000,"on":0,"off":30},{"kind":"input","t":119869.967062,"text":"The disease is carried by pigs, which then migrates to humans through mosquitoes."},{"kind":"text","t":120722.215345,"text":"এই রোগটি শুকরদের দ্বারা বাহিত হয়, যা পরবর্তীতে মশার মাধ্যমে মানুষের শরীরে স্থানান্তরিত হয়।"},{"kind":"audio","t":120854.611978,"samples":32768,"rate":24000,"on":250,"off":1360},{"kind":"audio","t":120859.643431,"samples":32768,"rate":24000,"on":0,"off":1330},{"kind":"audio","t":120865.329124,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":120870.652913,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120875.985311,"samples":32768,"rate":24000,"on":0,"off":1210},{"kind":"audio","t":120876.302236,"samples":2786,"rate":24000},{"kind":"input","t":129359.97702,"text":"Most modern research telescopes are enormous facilities in remote areas with favorable atmospheric conditions."},{"kind":"text","t":130317.387432,"text":"অধিকাংশ আধুনিক গবেষণা টেলিস্কোপগুলো অনুকূল বায়ুমণ্ডলীয় অবস্থার দূরবর্তী এলাকায় অবস্থিত বিশাল সব স্থাপনা।"},{"kind":"audio","t":130454.57189199999,"samples":32768,"rate":24000,"on":220,"off":1360},{"kind":"audio","t":130459.606686,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":130465.159581,"samples":32768,"rate":24000,"on":120,"off":1320},{"kind":"audio","t":130470.415261,"samples":32768,"rate":24000,"on":420,"off":1270},{"kind":"audio","t":130475.765959,"samples":32768,"rate":24000,"on":200,"off":1360},{"kind":"audio","t":130477.26429400001,"samples":12817,"rate":24000,"on":30,"off":250},{"kind":"input","t":135223.480932,"text":"People may not anticipate that patience and understanding are also necessary for travelers"},{"kind":"text","t":136032.543844,"text":"মানুষ হয়তো এটা আন্দাজ করতে পারে না যে ভ্রমণকারীদের জন্য ধৈর্য এবং সহনশীলতাও প্রয়োজন।"},{"kind":"audio","t":136137.051214,"samples":32768,"rate":24000,"on":260,"off":1340},{"kind":"audio","t":136142.05821900003,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":136147.47023600002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":136151.982649,"samples":28198,"rate":24000,"on":0,"off":900},{"kind":"input","t":140541.42036800002,"text":"So it is likely that the notation was added simply as a label."},{"kind":"text","t":141134.77715500002,"text":"তাই সম্ভবত সংকেতটি কেবল একটি লেবেল হিসেবে যোগ করা হয়েছিল।"},{"kind":"audio","t":141221.41745100002,"samples":32768,"rate":24000,"on":290,"off":1300},{"kind":"audio","t":141226.508414,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":141231.9696,"samples":32768,"rate":24000,"on":0,"off":1170},{"kind":"audio","t":141232.27107500003,"samples":3677,"rate":24000},{"kind":"input","t":147770.755666,"text":"But there are a lot of things about birds that still look like a dinosaur."},{"kind":"text","t":148433.41795600002,"text":"কিন্তু পাখিদের এমন অনেক কিছু আছে যা এখনও ডাইনোসরের মতো মনে হয়।"},{"kind":"audio","t":148522.44473100003,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":148527.38352600002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":148532.842623,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":148533.407493,"samples":8136,"rate":24000,"on":0,"off":40},{"kind":"input","t":154956.144616,"text":"They are almost all sandy beaches with safe swimming and most have shade provided by"},{"kind":"text","t":155896.91076300002,"text":"এগুলো প্রায় সবই বালুকাময় সৈকত যেখানে সাঁতার কাটা নিরাপদ এবং বেশিরভাগ জায়গাতেই ছায়ার ব্যবস্থা রয়েছে।"},{"kind":"audio","t":156026.836038,"samples":32768,"rate":24000,"on":260,"off":1360},{"kind":"audio","t":156032.05657800002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":156037.30389900002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":156042.541629,"samples":32768,"rate":24000,"on":0,"off":1120},{"kind":"audio","t":156047.851838,"samples":32768,"rate":24000,"on":40,"off":1360},{"kind":"audio","t":156048.974179,"samples":10309,"rate":24000,"on":0,"off":130},{"kind":"input","t":157898.444701,"text":"Pohican trees."},{"kind":"text","t":158177.834716,"text":"পোহিকান গাছ।"},{"kind":"audio","t":158212.02787000002,"samples":30092,"rate":24000,"on":260,"off":930},{"kind":"input","t":164345.593487,"text":"Duvall, who is married with two adult children, did not leave a big impression on Miller, to whom the story was related."},{"kind":"text","t":165613.864574,"text":"ডুভ্যাল, যিনি বিবাহিত এবং যার দুজন প্রাপ্তবয়স্ক সন্তান রয়েছে, মিলারের ওপর তেমন কোনো প্রভাব ফেলেননি, যার কাছে গল্পটি বলা হয়েছিল।"},{"kind":"audio","t":165786.003896,"samples":32768,"rate":24000,"on":260,"off":1360},{"kind":"audio","t":165791.00656,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":165796.50034600002,"samples":32768,"rate":24000,"on":360,"off":1360},{"kind":"audio","t":165802.04823100002,"samples":32768,"rate":24000,"on":0,"off":1300},{"kind":"audio","t":165807.797492,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":165813.41039600002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":165818.576898,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":16