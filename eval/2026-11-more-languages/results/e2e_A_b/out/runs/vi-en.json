360},{"kind":"audio","t":49412.098981,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":49417.416406000004,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":49420.375048,"samples":23128,"rate":24000,"on":0,"off":360},{"kind":"input","t":54801.257637,"text":"Thực giật tạo ra thức ăn của chúng từ mặt trời bằng cách quan hợp."},{"kind":"text","t":55250.597295,"text":"Plants create their food from the sun through photosynthesis."},{"kind":"audio","t":55351.376657,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":55356.377877,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":55362.064276000005,"samples":32768,"rate":24000,"on":0,"off":1030},{"kind":"audio","t":55362.40835,"samples":5496,"rate":24000},{"kind":"input","t":56884.778187,"text":"Chúng cũng mang lại bóng găm."},{"kind":"text","t":57155.62374,"text":"They also provide shade."},{"kind":"audio","t":57258.534845,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":57261.142632,"samples":22432,"rate":24000,"on":0,"off":390},{"kind":"input","t":65740.610099,"text":"Bệnh viện này đã làm theo quy trình kiểm soát, lây nhiễm, bao gồm cách ly bệnh nhân."},{"kind":"text","t":66219.98784599999,"text":"This hospital followed infection control procedures, including patient isolation."},{"kind":"audio","t":66334.293872,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":66335.62642999999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":66337.12116499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":66338.725339,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":66339.203891,"samples":18328,"rate":24000,"on":0,"off":130},{"kind":"input","t":71728.57705699999,"text":"với các bệnh nhân khác để ngăn ngừa lây nhiễm có thể có cho những người khác."},{"kind":"text","t":72173.298319,"text":"from other patients to prevent potential infection of others."},{"kind":"audio","t":72284.806361,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":72289.590002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":72295.585203,"samples":32768,"rate":24000,"on":0,"off":1330},{"kind":"audio","t":72296.59402599999,"samples":12696,"rate":24000},{"kind":"input","t":82109.09672799999,"text":"Công việc hoàn thành chủ yếu là lý thiết, nhưng chương trình được viết ra để mô phỏng."},{"kind":"text","t":82733.526982,"text":"The work completed is primarily theoretical, but the program was written for simulation."},{"kind":"audio","t":82853.92523699999,"samples":32768,"rate":24000,"on":390,"off":1330},{"kind":"audio","t":82859.12451099999,"samples":32768,"rate":24000,"on":100,"off":1360},{"kind":"audio","t":82864.139858,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":82869.4086,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":82872.98017099999,"samples":26128,"rate":24000,"on":0,"off":460},{"kind":"input","t":85604.907297,"text":"Sự quan sát của thiên hà nhân mã"},{"kind":"text","t":85914.766943,"text":"Observation of the Centaurus galaxy"},{"kind":"audio","t":86014.09922799999,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":86019.26523199999,"samples":32768,"rate":24000,"on":0,"off":1230},{"kind":"audio","t":86019.949721,"samples":11264,"rate":24000},{"kind":"input","t":91408.182626,"text":"Ngôn ngữ chính thức của Barcelona là tiếng"},{"kind":"text","t":91698.74812199999,"text":"The official language of Barcelona is"},{"kind":"audio","t":91799.325885,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":91804.46893999999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91805.166858,"samples":12464,"rate":24000,"on":0,"off":30},{"kind":"input","t":98526.84563,"text":"Catalan và tiếng Tây Ban Nha Khoảng một nửa dân số thích Nói tiếng Catalan hơn"},{"kind":"text","t":99096.58995,"text":"Catalan and Spanish. About half of the population prefers speaking Catalan."},{"kind":"audio","t":99194.137854,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":99196.140751,"samples":20032,"rate":24000,"on":0,"off":320},{"kind":"audio","t":99279.122586,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":99284.422068,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":99289.882638,"samples":32768,"rate":24000,"on":0,"off":840},{"kind":"audio","t":99290.15779299999,"samples":2496,"rate":24000},{"kind":"input","t":104175.179226,"text":"Và đại đa số người dân hiểu thứ tiếng này, hầu như ai cũng biết tiếng Tây Ban Nha."},{"kind":"text","t":104831.03015899999,"text":"And the vast majority of people understand this language, and almost everyone knows Spanish."},{"kind":"audio","t":104938.94634099999,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":104944.349212,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":104949.448947,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":104954.773259,"samples":32768,"rate":24000,"on":0,"off":1330},{"kind":"audio","t":104958.511397,"samples":25528,"rate":24000,"on":20,"off":500},{"kind":"input","t":112395.696604,"text":"Ở một số nơi chỉ cần đun nước sôi 1 phút là đủ, trong khi ở những nơi khác cần phải đun sôi vài phút."},{"kind":"text","t":113445.81331499999,"text":"In some places, boiling water for just 1 minute is enough, while in others, it needs to be boiled for several minutes."},{"kind":"audio","t":113563.084402,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":113568.21576699999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113573.48874,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113580.11666,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113584.68512499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113590.36575099999,"samples":32768,"rate":24000,"on":0,"off":1060},{"kind":"audio","t":113590.655436,"samples":5592,"rate":24000},{"kind":"input","t":119623.32208299999,"text":"Cây cối đẹp nhất là khi ở trong môi trường thiên nhiên, vì vậy hãy cố cưỡng lại sự cám dỗ của việc."},{"kind":"text","t":120321.302279,"text":"Trees are most beautiful in their natural environment, so try to resist the temptation of."},{"kind":"audio","t":120434.931226,"samples":32768,"rate":24000,"on":370,"off":1360},{"kind":"audio","t":120440.193479,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120445.300865,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120450.68430499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120454.04679,"samples":24928,"rate":24000,"on":0,"off":360},{"kind":"input","t":123619.309816,"text":"Lội bỏ cho dù chỉ một lời nào đó"},{"kind":"text","t":123936.115427,"text":"Leaving out even a single word"},{"kind":"audio","t":124034.430098,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":124039.12301,"samples":32768,"rate":24000,"on":0,"off":840},{"kind":"audio","t":124039.27378799999,"samples":464,"rate":24000},{"kind":"input","t":130377.456904,"text":"Trong thập niên 1920, quan điểm phổ biến của hầu hết mọi công dân"},{"kind":"text","t":131001.90841799999,"text":"In the 1920s, the common view of most citizens"},{"kind":"audio","t":131108.644379,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":131113.822483,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131119.226734,"samples":32768,"rate":24000,"on":0,"off":1230},{"kind":"audio","t":131119.722935,"samples":9696,"rate":24000},{"kind":"input","t":135512.76920900002,"text":"và quốc gia là theo phinh hướng của chủ nghĩa hòa bình và cô lập."},{"kind":"text","t":136131.55990700002,"text":"and the nation was to follow the direction of pacifism and isolationism."},{"kind":"audio","t":136237.089148,"samples":32768,"rate":24000,"on":420,"off":1350},{"kind":"audio","t":136242.324912,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":136247.970248,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":136253.564305,"samples":32768,"rate":24000,"on":0,"off":1050},{"kind":"audio","t":136253.719803,"samples":6928,"rate":24000},{"kind":"input","t":146043.122157,"text":"Thương lông là loài ăn thịt đỉnh cao trong thời kỳ tồn tại của nó. Vì thế, thương lông là loài ăn thịt đỉnh cao trong thời kỳ tồn tại của nó."},{"kind":"text","t":146678.830664,"text":"The woolly mammoth was an apex predator during its existence. Therefore, the woolly mammoth was an apex predator during its existence."},{"kind":"audio","t":146791.858262,"samples":32768,"rate":24000,"on":410,"off":1340},{"kind":"audio","t":146797.12100500002,"samples":32768,"rate":24000,"on":230,"off":1360},{"kind":"audio","t":146802.572084,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":146804.00124100002,"samples":13896,"rate":24000,"on":0,"off":40},{"kind":"audio","t":146890.32337,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":146895.816599,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":146901.065892,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":146904.945608,"samples":27096,"rate":24000,"on":0,"off":560},{"kind":"input","t":149492.98857800002,"text":"Nó không sợ gì cả ngoại trừ những con thương lông khác"},{"kind":"text","t":149950.909101,"text":"It feared nothing except other woolly mammoths."},{"kind":"audio","t":150049.840272,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":150055.059866,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":150057.381567,"samples":19664,"rate":24000,"on":0,"off":270},{"kind":"input","t":153426.54279500002,"text":"Kể từ khi thành lập"},{"kind":"text","t":153631.131315,"text":"Since its establishment"},{"kind":"audio","t":153727.012667,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":153729.072113,"samples":19432,"rate":24000,"on":0,"off":260},{"kind":"input","t":158607.377117,"text":"A-son-si-on vào năm 1537."},{"kind":"text","t":159011.04664800002,"text":"Asunción in 1537."},{"kind":"audio","t":159116.086848,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":159121.233553,"samples":32768,"rate":24000,"on":0,"off":1080},{"kind":"audio","t":159121.571617,"samples":7664,"rate":24000},{"kind":"input","t":163943.262139,"text":"Paraguay đã cố gắng duy trì những đặc điểm và bản sắc bản địa của mình."},{"kind":"text","t":164491.26184000002,"text":"Paraguay has tried to maintain its indigenous characteristics and identity."},{"kind":"audio","t":164593.210161,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":164594.766505,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":164596.10809300002,"samples":32768,"rate":24000,"on":0,"off":1280},{"kind":"audio","t":164597.701116,"samples":32768,"rate":24000,"on":200,"off":920},{"kind":"audio","t":164598.001171,"samples":4528,"rate":24000},{"kind":"input","t":171459.154172,"text":"Căn mệnh được truyền trên lợn, sau đó di trú sang người thông qua mũi."},{"kind":"text","t":172081.249205,"text":"The fate was transmitted to pigs, then migrated to humans through the nose."},{"kind":"audio","t":172186.63286900002,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":172191.654816,"samples":32768,"rate":24000,"on":0,"off":1050},{"kind":"audio","t":172197.073446,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":172202.750482,"samples":32768,"rate":24000,"on":0,"off":1020},{"kind":"audio","t":172203.062707,"samples":5128,"rate":24000},{"kind":"input","t":183181.65040800002,"text":"Hầu hết kính viễn vọng hiện đại dùng cho nghiên cứu đều là những thiết bị khổng lồ được đặt ở những khu vực hẻo lắng có điều kiện khí hậu thuận lợi."},{"kind":"text","t":183847.621924,"text":"Most modern research telescopes are giant instruments located in remote areas with favorable climatic conditions."},{"kind":"audio","t":183966.114791,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":183971.117558,"samples":32768,"rate":24000,"on":0,"off":1100},{"kind":"audio","t":183976.48331900002,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":183981.761452,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":183986.915576,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":183991.983902,"samples":32768,"rate":24000,"on":0,"off":1280},{"kind":"audio","t":183993.061284,"samples":16992,"rate":24000,"on":30,"off":120},{"kind":"input","t":190150.403777,"text":"Người ta có thể không lần trước được gần sự kiên nhẫn và thấu hiểu, cũng rất cần thiết cho việc hồi hương."},{"kind":"text","t":190927.279885,"text":"One might not have previously come close to the patience and understanding that are also essential for repatriation."},{"kind":"audio","t":191044.947885,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":191046.509989,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":191048.098843,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":191049.55131900002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":191051.399788,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":191051.88002,"samples":20360,"rate":24000,"on":0,"off":190},{"kind":"input","t":196090.781133,"text":"Vậy là có khả năng chú thích được thêm vào, đơn giản chỉ là nhãn đánh dấu."},{"kind":"text","t":196719.085163,"text":"Thus, it is possible that annotations can be added, simply as markers."},{"kind":"audio","t":196824.707173,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":196830.05243500002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":196835.14420100002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":196840.874576,"samples":32768,"rate":24000,"on":0,"off":1030},{"kind":"audio","t":196841.22745,"samples":5728,"rate":24000},{"kind":"input","t":202053.75365600002,"text":"Tuy nhiên, lò chim vẫn có rất nhiều điểm giống với khủng long."},{"kind":"text","t":202506.78838,"text":"However, birds still have many similarities to dinosaurs."},{"kind":"audio","t":202612.003047,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":202617.21667,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":202622.542882,"samples":32768,"rate":24000,"on":0,"off":1230},{"kind":"audio","t":202623.10282300002,"samples":10296,"rate":24000},{"kind":"input","t":208434.389009,"text":"Chúng hầu hết đều là vẻ biển cát an toàn cho việc bơi lội và hầu hết có bóng mát."},{"kind":"text","t":209024.26300500002,"text":"Most of them are safe sandy beaches for swimming and most have shade."},{"kind":"audio","t":209133.879049,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":209135.60192100002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":209137.194664,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":209137.81639400002,"samples":20496,"rate":24000,"on":0,"off":280},{"kind":"input","t":211459.32381,"text":"từ các cây Mohutugawa."},{"kind":"text","t":211803.219552,"text":"from the Mohutugawa trees."},{"kind":"audio","t":211904.063551,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":211906.08237800002,"samples":27232,"rate":24000,"on":0,"off":600},{"kind":"input","t":217883.715638,"text":"Duvall đã kết hôn và có hai người con trưởng thành."},{"kind":"text","t":218361.744497,"text":"Duvall is married and has two adult children."},{"kind":"audio","t":218465.94398100002,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":218470.93436800002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":218473.325889,"samples":19664,"rate":24000,"on":0,"off":190},{"kind":"input","t":223889.162977,"text":"Không để lại ấn tượng gì nhiều với Myler, người có liên quan đến câu chuyện."},{"kind":"text","t":224508.02693300002,"text":"It left little impression on Myler, who was involved in the story."},{"kind":"audio","t":224609.647409,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":224614.61226700002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":224619.93035900002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":224620.374711,"samples":16296,"rate":24000,"on":0,"off":70},{"kind":"close","t":234904.308832,"code":1005}]}