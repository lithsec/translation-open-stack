,"samples":32768,"rate":24000,"on":0,"off":930},{"kind":"audio","t":31766.588440000003,"samples":3096,"rate":24000},{"kind":"input","t":34668.790573,"text":"و هیچ وقت مجبور نیستم به مداد تراش نزدیک شاند"},{"kind":"text","t":35186.913802999996,"text":"And I never have to go near a pencil sharpener."},{"kind":"audio","t":35286.473607,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":35291.917475999995,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":35294.383114,"samples":20864,"rate":24000,"on":40,"off":270},{"kind":"input","t":44243.253411,"text":"محدودیت مسافران برای کشورهایی که مالیات سنگین دارد"},{"kind":"text","t":44653.177651,"text":"Passenger limits for countries that have heavy taxes."},{"kind":"audio","t":44753.877975999996,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":44759.317935,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":44763.719781,"samples":29864,"rate":24000,"on":0,"off":660},{"kind":"input","t":56053.13024,"text":"گاهی اوقات میتواند موجب صرف جویی قابل توجهی شود بخصوص در مورد محصولاتی مانند مشروبات الکلی و دخانیات"},{"kind":"text","t":56780.96482,"text":"Sometimes it can lead to significant savings, especially for products such as alcoholic beverages and tobacco."},{"kind":"audio","t":56893.417058,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":56898.608330999996,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":56903.775205,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":56909.107546,"samples":32768,"rate":24000,"on":0,"off":1180},{"kind":"audio","t":56914.542595,"samples":32768,"rate":24000,"on":140,"off":1360},{"kind":"audio","t":56919.780777,"samples":32768,"rate":24000,"on":0,"off":820},{"kind":"audio","t":56920.108602,"samples":1392,"rate":24000},{"kind":"input","t":67115.319151,"text":"گیاهان با فوتوسندس غذای خود را از خورشید تهیه میکنند آنها همچنین سایه فراهم میکنند"},{"kind":"text","t":67780.886483,"text":"Plants produce their own food from the sun through photosynthesis; they also provide shade."},{"kind":"audio","t":67890.065696,"samples":32768,"rate":24000,"on":400,"off":1330},{"kind":"audio","t":67895.410947,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":67900.710698,"samples":32768,"rate":24000,"on":140,"off":1290},{"kind":"audio","t":67901.728571,"samples":12096,"rate":24000},{"kind":"audio","t":67972.621235,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":67973.064547,"samples":21832,"rate":24000,"on":0,"off":370},{"kind":"input","t":72642.538107,"text":"این بیمارستان از پروتوکلی برای کنترل عفونت استفاده کرده است"},{"kind":"text","t":73099.516899,"text":"This hospital has used a protocol for infection control."},{"kind":"audio","t":73201.18923799999,"samples":32768,"rate":24000,"on":390,"off":1290},{"kind":"audio","t":73206.309752,"samples":32768,"rate":24000,"on":190,"off":1360},{"kind":"audio","t":73211.579104,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":73212.798124,"samples":13296,"rate":24000},{"kind":"input","t":78941.60133599999,"text":"از جمله جدا كردن بیمار از سایرین برای جلوگیری از احتمال افونت سایرین"},{"kind":"text","t":79530.369103,"text":"Including isolating the patient from others to prevent the possibility of infecting others."},{"kind":"audio","t":79644.522453,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":79650.06119,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79655.10356599999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79660.417197,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79664.514068,"samples":28528,"rate":24000,"on":0,"off":620},{"kind":"input","t":91787.483438,"text":"کار انجام شده عمدتا نظری بود ولی این برنامه برای شبیهسازی مشاهدات صورت گرفته از کهکشان قوس نوشته شده بود"},{"kind":"text","t":92621.242675,"text":"The work performed was primarily theoretical, but this program was written to simulate observations made of the Sagittarius galaxy."},{"kind":"audio","t":92739.455617,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":92744.580561,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":92749.608687,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":92755.135465,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":92760.469915,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":92765.737627,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":92770.142224,"samples":29592,"rate":24000,"on":60,"off":600},{"kind":"input","t":98906.730752,"text":"زبانهای رسمی بارسلونا عبارتند از کاتالان و اسپانیایی"},{"kind":"text","t":99363.466428,"text":"The official languages of Barcelona are Catalan and Spanish."},{"kind":"audio","t":99465.785936,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":99470.785733,"samples":32768,"rate":24000,"on":0,"off":1050},{"kind":"audio","t":99475.97534599999,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":99478.46580399999,"samples":19296,"rate":24000,"on":0,"off":250},{"kind":"input","t":104508.436201,"text":"حدود نیمی از مردم مردم ترجیح میدهند به کاتلان صحبت کنند"},{"kind":"text","t":104959.889576,"text":"About half of the people prefer to speak Catalan."},{"kind":"audio","t":105057.448913,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":105062.764064,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":105065.949241,"samples":23264,"rate":24000,"on":0,"off":370},{"kind":"input","t":112973.65381999999,"text":"اکثریت غریب به اتفاق این زبان را میفهمند و تقریبا همه اسپانیایی میدانند"},{"kind":"text","t":113527.799147,"text":"The overwhelming majority understand this language, and almost everyone knows Spanish."},{"kind":"audio","t":113634.398213,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":113639.468908,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113644.486794,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113649.96982299999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113652.400842,"samples":19528,"rate":24000,"on":0,"off":240},{"kind":"input","t":124277.261312,"text":"در برخی از مناطق جوشاندن آب برای یک دقیقه کافی است و در برخی دیگر لازم از چند دقیقه جوشانده شود"},{"kind":"text","t":125259.007493,"text":"In some areas, boiling water for one minute is sufficient, and in others, it needs to be boiled for several minutes."},{"kind":"audio","t":125377.436411,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":125378.614961,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":125380.117776,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":125381.649491,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":125383.301523,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":125384.120089,"samples":25760,"rate":24000,"on":0,"off":510},{"kind":"input","t":131641.324109,"text":"گیاهان وقتی در محیط طبیعی هستند بهترین حالت خود را دارند"},{"kind":"text","t":132203.257665,"text":"Plants are at their best when they are in their natural environment."},{"kind":"audio","t":132304.606909,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":132309.900571,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":132315.31493,"samples":32768,"rate":24000,"on":0,"off":970},{"kind":"audio","t":132315.601115,"samples":7296,"rate":24000},{"kind":"input","t":137210.447062,"text":"بنابراین در برابر وسوسهی حذف فقط یک نمونه نیست"},{"kind":"text","t":137763.648705,"text":"Therefore, the temptation to remove just one sample is not absent."},{"kind":"audio","t":137868.964512,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":137870.451647,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":137871.88387299998,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":137872.637991,"samples":24696,"rate":24000,"on":0,"off":330},{"kind":"input","t":139042.092161,"text":"morao je matskoj nic"},{"kind":"text","t":140551.413263,"text":"It seems you provided a sentence in a different language (likely Serbian/Croatian/Bosnian) instead of Persian. However, translating that specific sentence into English:\n\nHe had to give the cat nothing."},{"kind":"audio","t":140665.979346,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":140671.189139,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140676.364932,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140681.769652,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140686.926205,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140691.582058,"samples":29960,"rate":24000,"on":0,"off":590},{"kind":"audio","t":140760.16527,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":140765.391442,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140770.872461,"samples":32768,"rate":24000,"on":0,"off":1060},{"kind":"audio","t":140771.220715,"samples":6096,"rate":24000},{"kind":"audio","t":140833.03772,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":140836.78661799998,"samples":28432,"rate":24000,"on":0,"off":600},{"kind":"input","t":152280.641422,"text":"در دهه هزار نه سد و بیست نگرش غالب در بیشتر شهروندام و ملتها"},{"kind":"text","t":152981.741059,"text":"In the 1920s, the dominant attitude among most citizens and nations"},{"kind":"audio","t":153083.89647,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":153085.258527,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":153086.978818,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":153088.67664,"samples":32768,"rate":24000,"on":0,"off":1210},{"kind":"audio","t":153088.826577,"samples":9928,"rate":24000},{"kind":"input","t":154946.161476,"text":"نگرش صلح و انزوا بود"},{"kind":"text","t":155284.27449799998,"text":"was an attitude of peace and isolation"},{"kind":"audio","t":155381.450062,"samples":32768,"rate":24000,"on":410,"off":1320},{"kind":"audio","t":155384.60214899998,"samples":32768,"rate":24000,"on":40,"off":1290},{"kind":"audio","t":155385.083101,"samples":10664,"rate":24000},{"kind":"input","t":164739.646798,"text":"موسی سر برترین شکارچی در دورهٔ خود بود به همین خاطر از هیچ چیز نمیترسید"},{"kind":"text","t":165466.073022,"text":"Musa was the top predator of his time; for this reason, he feared nothing."},{"kind":"audio","t":165571.408039,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":165576.621912,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":165578.062728,"samples":14864,"rate":24000,"on":0,"off":20},{"kind":"audio","t":165658.11433799998,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":165663.241673,"samples":32768,"rate":24000,"on":0,"off":850},{"kind":"audio","t":165663.56548699999,"samples":1664,"rate":24000},{"kind":"input","t":170352.320784,"text":"ماجر سعير المصاصور هه"},{"kind":"text","t":170869.926622,"text":"The story of Sa'ir al-Massasur."},{"kind":"audio","t":170969.623484,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":170970.907342,"samples":32768,"rate":24000,"on":50,"off":880},{"kind":"audio","t":170971.182448,"samples":2264,"rate":24000},{"kind":"input","t":184255.225557,"text":"پاراگوئه از زمان تاسیس آسان سی ون در سال هزار پند صدر سی و هفت تمانسته است بسیاری از خصوصیات و شخصیاتهای بومی خود را حفظ کند"},{"kind":"text","t":185376.084361,"text":"Since the founding of Asan C1 in 1537, Paraguay has remained committed to preserving many of its indigenous characteristics and personalities."},{"kind":"audio","t":185502.18353,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":185503.553697,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":185505.054952,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":185506.490608,"samples":32768,"rate":24000,"on":540,"off":1360},{"kind":"audio","t":185508.287358,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":185509.856962,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":185511.412266,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":185512.994649,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":185513.746327,"samples":13856,"rate":24000},{"kind":"input","t":192517.162349,"text":"خوکها حامل این بیماری هستند و سپس از طریق پشهها به انسان منتقل میشو"},{"kind":"text","t":193184.236976,"text":"Pigs carry this disease, and it is then transmitted to humans via mosquitoes."},{"kind":"audio","t":193290.079265,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":193294.917144,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":193300.455501,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":193305.714293,"samples":32768,"rate":24000,"on":0,"off":1250},{"kind":"audio","t":193306.50613,"samples":10528,"rate":24000},{"kind":"input","t":205043.561148,"text":"اکثر تلسکوپ های تحقیقاتی مدرن تاسیسات بزرگی میباشند که در نواحی دوردست با شرایط جوی مطلوب قرار دارند"},{"kind":"text","t":205707.32409,"text":"Most modern research telescopes are large facilities located in remote areas with favorable atmospheric conditions."},{"kind":"audio","t":205822.07083,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":205827.217813,"samples":32768,"rate":24000,"on":0,"off":1050},{"kind":"audio","t":205832.670812,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":205838.066172,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":205843.218286,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":205848.576216,"samples":32768,"rate":24000,"on":0,"of