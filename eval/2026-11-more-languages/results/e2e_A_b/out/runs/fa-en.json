"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":240519.156976,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":240524.333489,"samples":32768,"rate":24000,"on":0,"off":900},{"kind":"audio","t":240524.607785,"samples":2128,"rate":24000},{"kind":"input","t":249878.457504,"text":"آنها تقریبا همهی سواحل شنی هستند که شنا در آن ایمن است"},{"kind":"text","t":250358.645308,"text":"They are almost all sandy beaches where swimming is safe."},{"kind":"audio","t":250460.026112,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":250463.905027,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":250466.492554,"samples":29264,"rate":24000,"on":0,"off":630},{"kind":"input","t":254541.48115099999,"text":"و اکثر آنها دارای سایه درختان پوهوتوکونا است"},{"kind":"text","t":255093.764149,"text":"And most of them have shade from Pohutukona trees."},{"kind":"audio","t":255192.072764,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":255195.454877,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":255198.171702,"samples":31664,"rate":24000,"on":0,"off":750},{"kind":"input","t":265743.503422,"text":"دوبال که با داشتن دو فرزند بزرگسال ازدواج کرده است"},{"kind":"text","t":266152.126824,"text":"Dubal, who married having two adult children"},{"kind":"audio","t":266258.697651,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":266263.905094,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":266265.617215,"samples":16664,"rate":24000,"on":0,"off":120},{"kind":"input","t":271795.136442,"text":"تأثیر زیادی بر میلر كه داستان به وی مربوط میشود نگذاشت"},{"kind":"text","t":272343.290069,"text":"It had little effect on Miller, to whom the story pertains."},{"kind":"audio","t":272448.625016,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":272453.75922,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":272459.313818,"samples":32768,"rate":24000,"on":30,"off":1050},{"kind":"audio","t":272459.503474,"samples":5496,"rate":24000},{"kind":"close","t":282505.462793,"code":1005}]}