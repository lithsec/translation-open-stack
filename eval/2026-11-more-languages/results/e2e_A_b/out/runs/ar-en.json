s":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":44966.127372999996,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":44967.757644,"samples":14728,"rate":24000,"on":0,"off":40},{"kind":"input","t":54212.61874400001,"text":"اتبعت المستشفى بروتوكول مكافحة العدوى بما في ذلك فصل المريض عن الآخرين لمنع انتقال العدوى المحتملة للآخرين"},{"kind":"text","t":55244.900045,"text":"The hospital followed an infection control protocol, including isolating the patient from others, to prevent the potential transmission of the infection to others."},{"kind":"audio","t":55372.839947,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":55378.163251000005,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":55383.34058800001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":55388.744261,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":55393.88892899999,"samples":32768,"rate":24000,"on":0,"off":1110},{"kind":"audio","t":55399.128555,"samples":32768,"rate":24000,"on":200,"off":1360},{"kind":"audio","t":55404.642676,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":55408.84242,"samples":32768,"rate":24000,"on":0,"off":1030},{"kind":"audio","t":55409.18623399999,"samples":6056,"rate":24000},{"kind":"input","t":63761.989606,"text":"أما العمل المنجز فأغلبه نظري ولكن البرنامج كتب لمحاكاة الملاحظات التي تم رصدها عن مجرة القوس"},{"kind":"text","t":64810.57900299999,"text":"As for the work completed, most of it is theoretical, but the program was written to simulate the observations recorded of the Sagittarius galaxy."},{"kind":"audio","t":64933.151681999996,"samples":32768,"rate":24000,"on":440,"off":1340},{"kind":"audio","t":64938.36955799999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":64943.736752,"samples":32768,"rate":24000,"on":0,"off":970},{"kind":"audio","t":64949.205514,"samples":32768,"rate":24000,"on":130,"off":1360},{"kind":"audio","t":64955.981342,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":64961.240827,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":64966.079610999994,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":64967.027323999995,"samples":16024,"rate":24000,"on":20,"off":30},{"kind":"input","t":77542.951048,"text":"لمدينة برشلونة لغتين رسميتين هما الكتالونية والإسبانية يفضل حوالي نصف السكان التحدث بالكتالونية"},{"kind":"text","t":78468.857779,"text":"The city of Barcelona has two official languages, Catalan and Spanish; about half of the population prefers to speak Catalan."},{"kind":"audio","t":78577.524877,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":78578.681676,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":78581.54826499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":78583.046798,"samples":32768,"rate":24000,"on":0,"off":840},{"kind":"audio","t":78583.171556,"samples":928,"rate":24000},{"kind":"audio","t":78667.708357,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":78672.847515,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":78677.98194299999,"samples":32768,"rate":24000,"on":40,"off":840},{"kind":"audio","t":78678.27935699999,"samples":1896,"rate":24000},{"kind":"input","t":79244.688435,"text":"ويفوه الغالبية العظمى ويعرف الجميع تقريبا الإسبانية"},{"kind":"text","t":79777.19686099999,"text":"The vast majority speak it, and almost everyone knows Spanish."},{"kind":"audio","t":79889.843387,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":79894.804058,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79900.168452,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79902.31286399999,"samples":18696,"rate":24000,"on":0,"off":230},{"kind":"input","t":88986.101237,"text":"في بعض المناطق يكفي غليان الماء لمدة دقيقة وفي مناطق أخرى تحتاج إلى غليها لعدة دقائق"},{"kind":"text","t":90003.522474,"text":"In some areas, boiling water for one minute is sufficient, while in other areas, you need to boil it for several minutes."},{"kind":"audio","t":90116.579734,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":90121.686522,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":90127.117335,"samples":32768,"rate":24000,"on":0,"off":1200},{"kind":"audio","t":90132.596026,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":90138.055368,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":90143.127997,"samples":32768,"rate":24000,"on":0,"off":860},{"kind":"audio","t":90143.430332,"samples":792,"rate":24000},{"kind":"input","t":101196.354769,"text":"تكون النباتات في أفضل أحوالها حينما تظل في بيئة طبيعية لذا قاوم رغبتك في القطف حتى ولو كانت عينة واحدة فقط"},{"kind":"text","t":102252.599779,"text":"Plants thrive best when left in their natural environment, so resist the urge to pick them, even if it is just a single specimen."},{"kind":"audio","t":102378.92064,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":102384.024639,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102389.02793899999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102394.370363,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102399.510121,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102404.88120399999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102408.292083,"samples":24792,"rate":24000,"on":0,"off":410},{"kind":"input","t":111420.222127,"text":"خلال العشرينيات من القرن الماضي كانت المواقف السائدة عند معظم المواطنين والأمم هي المسالمة والعزلة"},{"kind":"text","t":112397.993896,"text":"During the 1920s, the prevailing attitudes among most citizens and nations were those of peacefulness and isolation."},{"kind":"audio","t":112520.974867,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":112525.886719,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":112531.294912,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":112536.598957,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":112541.610157,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":112547.00211,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":112548.73425899999,"samples":20592,"rate":24000,"on":0,"off":230},{"kind":"input","t":122554.930476,"text":"كان الموزصور هو المفترس المهيمن في عصره لذلك لم يكن يهاب أي شيء باستثناء الموزصورات الأخرى"},{"kind":"text","t":123442.315168,"text":"The Mosasaurus was the dominant predator of its era, so it feared nothing except other Mosasaurs."},{"kind":"audio","t":123552.331173,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":123557.517599,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":123562.57452899999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":123568.07456,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":123573.28246599999,"samples":32768,"rate":24000,"on":40,"off":1260},{"kind":"audio","t":123574.25523899999,"samples":11360,"rate":24000},{"kind":"input","t":134469.604987,"text":"منذ تأسيس أوسونوسيون عام 1537 تمكنت باراكوي من الحفاظ على الكثير من طابعها الأصلي وهويته"},{"kind":"text","t":135518.095386,"text":"Since the founding of Asunción in 1537, Paraguay has been able to preserve much of its original character and identity."},{"kind":"audio","t":135637.30611499998,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":135642.341464,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":135647.448772,"samples":32768,"rate":24000,"on":10,"off":1030},{"kind":"audio","t":135652.58750999998,"samples":32768,"rate":24000,"on":190,"off":1360},{"kind":"audio","t":135657.963864,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":135663.23298899998,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":135668.242729,"samples":32768,"rate":24000,"on":130,"off":870},{"kind":"audio","t":135668.471855,"samples":4024,"rate":24000},{"kind":"input","t":142471.821366,"text":"يتم نقل المرض من خلال الخنازير والذي ينتقل بعد ذلك إلى البشر من خلال الباعوض"},{"kind":"text","t":143149.583683,"text":"The disease is transmitted through pigs, which is then passed to humans via mosquitoes."},{"kind":"audio","t":143257.67686099999,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":143262.719981,"samples":32768,"rate":24000,"on":0,"off":1200},{"kind":"audio","t":143267.77025,"samples":32768,"rate":24000,"on":280,"off":1360},{"kind":"audio","t":143273.205553,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143275.88784399998,"samples":20728,"rate":24000,"on":0,"off":290},{"kind":"input","t":153042.046643,"text":"معظم تليسكوبات البحوث الحديثة هي منشآت هائلة في المناطق النائية ذات الظروف الجوية الملائمة"},{"kind":"text","t":153714.430317,"text":"Most modern research telescopes are massive facilities located in remote areas with favorable weather conditions."},{"kind":"audio","t":153829.312543,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":153834.275704,"samples":32768,"rate":24000,"on":0,"off":1050},{"kind":"audio","t":153839.939502,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":153845.11679,"samples":32768,"rate":24000,"on":0,"off":1300},{"kind":"audio","t":153850.307186,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":153855.55570199998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":153857.436238,"samples":15192,"rate":24000,"on":0,"off":50},{"kind":"input","t":162457.992764,"text":"قد لا يتوقع الناس أن الصبر والتفاهم ضروريان أيضا للمسافرين العائدين إلى ديارهم"},{"kind":"text","t":163124.63336,"text":"People may not expect that patience and understanding are also necessary for travelers returning home."},{"kind":"audio","t":163242.366266,"samples":32768,"rate":24000,"on":400,"off":1330},{"kind":"audio","t":163247.556127,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":163252.58619,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":163258.049855,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":163263.162067,"samples":32768,"rate":24000,"on":0,"off":1240},{"kind":"audio","t":163264.466484,"samples":12560,"rate":24000},{"kind":"input","t":168532.701641,"text":"لذا فمن المرجح أنه تمت إضافة الرمز ببساطة كتسمية"},{"kind":"text","t":169165.148758,"text":"Therefore, it is likely that the symbol was simply added as a label."},{"kind":"audio","t":169273.447877,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":169278.465601,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":169283.764779,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":169285.940021,"samples":17496,"rate":24000,"on":0,"off":120},{"kind":"input","t":175189.78413,"text":"لكن هناك الكثير من الأشياء حول الطيور التي لا تجل تبدو مثل الدينوسورات"},{"kind":"text","t":175786.66521099998,"text":"But there are many things about birds that do not seem like dinosaurs."},{"kind":"audio","t":175894.926291,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":175899.964924,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":175905.38199,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":175907.805808,"samples":20496,"rate":24000,"on":0,"off":280},{"kind":"input","t":185599.162739,"text":"كل الشواطئ رملية تقريبا تسمح بسباحة آمنة ومعظمها تظلها أشجار البوتوكوة"},{"kind":"text","t":186473.731413,"text":"Almost all the sandy beaches allow for safe swimming, and most of them are shaded by bottletree trees."},{"kind":"audio","t":186588.599329,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":186594.025476,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":186599.446332,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":186605.052535,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":186610.01324,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":186610.706048,"samples":13760,"rate":24000},{"kind":"input","t":196130.994233,"text":"لم يترك دوفال المتزوج وله ولدان بالغان انطباعا مؤثرا في ميلر التي كانت محور القصة"},{"kind":"text","t":197220.21087,"text":"Duvall, who is married and has two adult sons, left no lasting impression on Miller, who was the center of the story."},{"kind":"audio","t":197338.850741,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":197343.963533,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":197349.647844,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":197354.946253,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":197360.612885,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":197366.194568,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":197367.702182,"samples":15192,"rate":24000},{"kind":"close","t":207406.19869699999,"code":1005}]}