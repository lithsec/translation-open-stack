57,"rate":24000,"on":0,"off":490},{"kind":"input","t":26271.835362,"text":"People now write messages on computer screens never having to come close to a sharpener."},{"kind":"text","t":27473.86261,"text":"يكتب الناس الآن رسائلهم على شاشات الكمبيوتر دون أن يضطروا أبداً للاقتراب من مبرأة أقلام."},{"kind":"audio","t":27690.817203,"samples":32768,"rate":24000,"on":300,"off":1360},{"kind":"audio","t":27695.545031999998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27701.468609,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27706.944375,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27712.264873,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27715.781302,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27719.051706,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27721.206938,"samples":23071,"rate":24000,"on":0,"off":870},{"kind":"input","t":37546.988037,"text":"Travelers bound for countries with heavy taxation can sometimes save a considerable amount of money, especially on products such as alcoholic beverages and tobacco."},{"kind":"text","t":39251.533286000005,"text":"يمكن للمسافرين المتوجهين إلى بلدان تفرض ضرائب باهظة توفير مبلغ كبير من المال في بعض الأحيان، خاصة عند شراء منتجات مثل المشروبات الكحولية والتبغ."},{"kind":"audio","t":39628.00049400001,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":39633.082045999996,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39638.402184000006,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39643.741462000005,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39649.052070000005,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39654.025704,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39657.27791800001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39660.67327,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39664.172659,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39667.947724,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39669.25666100001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39670.754055,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39672.44611600001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":39673.009886,"samples":16495,"rate":24000,"on":0,"off":610},{"kind":"input","t":45790.901908,"text":"Plants make their food from the sun by photosynthesis. They also provide shade."},{"kind":"text","t":46484.35183100001,"text":"تصنع النباتات غذاءها من الشمس عن طريق عملية التمثيل الضوئي. كما أنها توفر الظل."},{"kind":"audio","t":46640.590302,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":46645.803122,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":46651.255548,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":46656.500037000005,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":46661.835915,"samples":32768,"rate":24000,"on":100,"off":1360},{"kind":"audio","t":46662.782739,"samples":8359,"rate":24000,"on":0,"off":280},{"kind":"audio","t":46666.438555999994,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":46669.19340800001,"samples":27975,"rate":24000,"on":0,"off":1070},{"kind":"input","t":58075.932790000006,"text":"The hospital has followed protocol for infection control, including separating the patient from others to prevent possible infection of others."},{"kind":"text","t":59384.377601,"text":"اتبع المستشفى البروتوكول الخاص بمكافحة العدوى، بما في ذلك عزل المريض عن الآخرين لمنع احتمال إصابتهم بالعدوى."},{"kind":"audio","t":59639.08040200001,"samples":32768,"rate":24000,"on":250,"off":1360},{"kind":"audio","t":59644.181064000004,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59649.62497999999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59654.864579,"samples":32768,"rate":24000,"on":0,"off":1170},{"kind":"audio","t":59660.58335,"samples":32768,"rate":24000,"on":340,"off":1360},{"kind":"audio","t":59666.102675,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59669.473627,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59672.944237,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59676.112242,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59676.885849,"samples":12427,"rate":24000,"on":0,"off":320},{"kind":"input","t":68182.786915,"text":"The work done was mostly theoretical, but the program was written to simulate observations made of the Sagittarius galaxy."},{"kind":"text","t":69420.05982400001,"text":"كان العمل المنجز نظرياً في الغالب، ولكن تمت كتابة البرنامج لمحاكاة الملاحظات التي تم رصدها لمجرة الرامي."},{"kind":"audio","t":69725.115855,"samples":32768,"rate":24000,"on":300,"off":1360},{"kind":"audio","t":69730.24703700001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69735.822901,"samples":32768,"rate":24000,"on":0,"off":1010},{"kind":"audio","t":69741.565481,"samples":32768,"rate":24000,"on":250,"off":1360},{"kind":"audio","t":69746.76056200001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69752.221277,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69755.788786,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69759.073519,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69762.354172,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":69763.06126,"samples":12427,"rate":24000,"on":0,"off":410},{"kind":"input","t":78314.125686,"text":"Barcelona's official languages are Catalan and Spanish. About half prefer to speak Catalan, a vast majority understands it, and virtually everyone knows Spanish."},{"kind":"text","t":79492.154849,"text":"اللغات الرسمية في برشلونة هي الكتالونية والإسبانية. يفضل نحو نصفهم التحدث بالكتالونية، وتفهمها أغلبية ساحقة، بينما يعرف الجميع تقريباً الإسبانية."},{"kind":"audio","t":79633.477358,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":79638.55248,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79643.693861,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79649.185707,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79650.203649,"samples":10476,"rate":24000,"on":0,"off":280},{"kind":"audio","t":79728.442188,"samples":32768,"rate":24000,"on":80,"off":1360},{"kind":"audio","t":79733.54857,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79738.855828,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79744.57350900001,"samples":32768,"rate":24000,"on":520,"off":1360},{"kind":"audio","t":79749.997795,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79754.35018000001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79757.63902300001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79762.417291,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":79764.19213000001,"samples":29034,"rate":24000,"on":0,"off":1020},{"kind":"input","t":83796.993186,"text":"In some areas, boiling water for a minute is enough and other several minutes are needed."},{"kind":"text","t":84661.291537,"text":"في بعض المناطق، يكفي غلي الماء لمدة دقيقة واحدة، بينما تطلب مناطق أخرى عدة دقائق."},{"kind":"audio","t":84876.434301,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":84877.774578,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":84879.328611,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":84880.996293,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":84882.546436,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":84884.79904700001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":84886.203253,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":84887.094937,"samples":20842,"rate":24000,"on":0,"off":770},{"kind":"input","t":89859.69345,"text":"Plants look their best when in a natural environment, so resist the temptation to remove even just one stem."},{"kind":"text","t":90993.297531,"text":"تبدو النباتات في أفضل حالاتها عندما تكون في بيئة طبيعية، لذا قاوم الرغبة في إزالة ولو ساق واحدة فقط."},{"kind":"audio","t":91210.094906,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":91215.254207,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91220.506156,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91225.756316,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91231.33906900001,"samples":32768,"rate":24000,"on":0,"off":1030},{"kind":"audio","t":91236.97505200001,"samples":32768,"rate":24000,"on":260,"off":1360},{"kind":"audio","t":91240.34885400001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91243.537169,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":91246.862731,"samples":32768,"rate":24000,"on":0,"off":1330},{"kind":"audio","t":91247.161936,"samples":5182,"rate":24000},{"kind":"input","t":97273.906782,"text":"During the 1920s, the prevailing attitudes of most citizens and nations was that of pacifism and isolation."},{"kind":"text","t":98303.155805,"text":"خلال عشرينيات القرن الماضي، كانت المواقف السائدة لدى معظم المواطنين والدول هي السلمية والعزلة."},{"kind":"audio","t":98494.695166,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":98499.882107,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98505.608508,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98511.09986300001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98516.52892900001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98522.14432200001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98526.34499,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98529.598704,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":98529.78603,"samples":4235,"rate":24000,"on":10,"off":100},{"kind":"input","t":103529.27011900001,"text":"Masa Serif was the apex predator of its time, so it feared nothing except other Mosul"},{"kind":"text","t":104871.57935500001,"text":"كانت \"ماسا سيريف\" المفترس المهيمن في عصرها، لذا لم تكن تخشى شيئاً سوى \"موصول\" الأخرى."},{"kind":"audio","t":105061.04271200001,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":105066.022906,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":105071.401023,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":105077.147874,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":105082.499132,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":105087.756171,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":105091.747422,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":105092.051177,"samples":1337,"rate":24000},{"kind":"input","t":113142.18802500001,"text":"Since the foundation of Asuncion in 1537, Paraguay has managed to keep a lot of its indigenous character and identity."},{"kind":"text","t":114517.319733,"text":"منذ تأسيس أسونسيون عام 1537، تمكنت باراغواي من الحفاظ على الكثير من طابعها وهويتها الأصلية."},{"kind":"audio","t":114819.15344000001,"samples":32768,"rate":24000,"on":80,"off":1360},{"kind":"audio","t":114824.321521,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114829.624219,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114834.869879,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114840.965574,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114846.28351200001,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":114850.261813,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114853.422448,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114856.577434,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114859.06839100001,"samples":25801,"rate":24000,"on":0,"off":970},{"kind":"input","t":119869.32536300001,"text":"The disease is carried by pigs, which then migrates to humans through mosquitoes."},{"kind":"text","t":120622.594333,"text":"ينتقل المرض عن طريق الخنازير، ثم ينتقل إلى البشر عبر البعوض."},{"kind":"audio","t":120825.484979,"samples":32768,"rate":24000,"on":290,"off":1360},{"kind":"audio","t":120830.732758,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120836.464119,"samples":32768,"rate":24000,"on":0,"off":840},{"kind":"audio","t":120841.707418,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":120847.02536700001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120848.999163,"samples":14489,"rate":24000,"on":0,"off":530},{"kind":"input","t":129360.401503,"text":"Most modern research telescopes are enormous facilities in remote areas with favorable atmospheric conditions."},{"kind":"text","t":130558.56086900001,"text":"معظم التلسكوبات البحثية الحديثة هي منشآت ضخمة تقع في مناطق نائية ذات ظروف جوية ملائمة."},{"kind":"audio","t":130790.138179,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":130794.98277500001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":130800.29857300001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":130805.50106400001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":130810.75431300001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":130817.06780399999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":130820.35869700002,"samples":32768,