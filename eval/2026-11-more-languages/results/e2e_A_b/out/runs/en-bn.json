4000,"on":230,"off":1360},{"kind":"audio","t":48764.575979,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":48769.90732,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":48775.32218,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":48780.432466,"samples":30817,"rate":24000,"on":0,"off":970},{"kind":"input","t":58048.008843999996,"text":"The hospital has followed protocol for infection control, including separating the patient from others to prevent possible infection of others."},{"kind":"text","t":62819.449884,"text":"হাসপাতালটি সংক্রমণ নিয়ন্ত্রণের জন্য নির্ধারিত নিয়মাবলী মেনে চলেছে; অন্যদের সংক্রমণ রোধ করার জন্য রোগীকে অন্যদের থেকে আলাদা রাখা হয়েছে।"},{"kind":"audio","t":62929.085272,"samples":32768,"rate":24000,"on":210,"off":1360},{"kind":"audio","t":62932.071253,"samples":32768,"rate":24000,"on":0,"off":960},{"kind":"audio","t":62935.27218,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":62937.400154999996,"samples":20674,"rate":24000,"on":0,"off":480},{"kind":"audio","t":62960.625141,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":62962.001598,"samples":32768,"rate":24000,"on":0,"off":1140},{"kind":"audio","t":62963.433835,"samples":32768,"rate":24000,"on":180,"off":1360},{"kind":"audio","t":62964.076614000005,"samples":20117,"rate":24000,"on":0,"off":530},{"kind":"input","t":68160.60191,"text":"The work done was mostly theoretical, but the program was written to simulate observations made of the Sagittarius galaxy."},{"kind":"text","t":73086.608588,"text":"এখানে করা কাজগুলো মূলত তাত্ত্বিক ছিল, কিন্তু স্যাজিটেরিয়াস গ্যালাক্সি সম্পর্কে করা পর্যবেক্ষণগুলোকে অনুকরণ করার জন্যই এই প্রোগ্রামটি লেখা হয়েছিল।"},{"kind":"audio","t":73246.842309,"samples":32768,"rate":24000,"on":220,"off":1360},{"kind":"audio","t":73251.982214,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":73257.605762,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":73262.759556,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":73268.053749,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":73273.497479,"samples":32768,"rate":24000,"on":0,"off":1190},{"kind":"audio","t":73273.842743,"samples":2897,"rate":24000},{"kind":"input","t":78290.17690800001,"text":"Barcelona's official languages are Catalan and Spanish. About half prefer to speak Catalan, a vast majority understands it, and virtually everyone knows Spanish."},{"kind":"text","t":83207.258002,"text":"বার্সেলোনার সরকারি ভাষা হলো কাতালান ও স্প্যানিশ। প্রায় অর্ধেক মানুষ কাতালান ভাষায় কথা বলতে পছন্দ করে, বিপুল সংখ্যক মানুষ এটি বুঝতে পারে, এবং প্রায় সবাই স্প্যানিশ জানে।"},{"kind":"audio","t":83417.043605,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":83422.261329,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":83427.960725,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":83433.47518400001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":83438.639148,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":83444.026249,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":83448.302039,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":83451.560505,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":83453.939705,"samples":24018,"rate":24000,"on":0,"off":710},{"kind":"input","t":83835.44784000001,"text":"In some areas, boiling water for a minute is enough and other several minutes are needed."},{"kind":"text","t":87377.720027,"text":"কিছু ক্ষেত্রে এক মিনিট ধরে পানি ফুটিয়ে রাখলেই যথেষ্ট, আবার অন্য ক্ষেত্রে কয়েক মিনিট সময় প্রয়োজন।"},{"kind":"audio","t":87497.646305,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":87502.78121,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":87508.22244,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":87513.770088,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":87517.98944800001,"samples":26080,"rate":24000,"on":80,"off":780},{"kind":"input","t":89843.909678,"text":"Plants look their best when in a natural environment, so resist the temptation to remove even just one stem."},{"kind":"text","t":93912.520345,"text":"উদ্ভিদগুলো প্রাকৃতিক পরিবেশে থাকলেই সবচেয়ে সুন্দর দেখায়; তাই এমনকি একটি ডালও সরানোর প্রলোভন প্রতিরোধ করুন।"},{"kind":"audio","t":94023.95345300001,"samples":32768,"rate":24000,"on":220,"off":1360},{"kind":"audio","t":94029.063139,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":94034.204964,"samples":30037,"rate":24000,"on":0,"off":970},{"kind":"audio","t":94039.87162,"samples":32768,"rate":24000,"on":230,"off":1360},{"kind":"audio","t":94045.245301,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":94045.985549,"samples":9696,"rate":24000,"on":0,"off":120},{"kind":"input","t":97260.67907900001,"text":"During the 1920s, the prevailing attitudes of most citizens and nations was that of pacifism and isolation."},{"kind":"text","t":100213.245742,"text":"১৯২০-এর দশকে, বেশিরভাগ নাগরিক ও জাতির প্রচলিত মনোভাব ছিল শান্তিবাদ ও বিচ্ছিন্নতাবাদ।"},{"kind":"audio","t":100361.993163,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":100367.179468,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":100372.613648,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":100378.28291400001,"samples":32768,"rate":24000,"on":0,"off":1040},{"kind":"audio","t":100383.763494,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":100385.03473300001,"samples":11145,"rate":24000,"on":0,"off":190},{"kind":"input","t":103515.598123,"text":"Masa Serif was the apex predator of its time, so it feared nothing except other Mosul"},{"kind":"text","t":106725.593831,"text":"মাসা সেরিফ ছিল তার সময়ের সর্বোচ্চ শিকারী; তাই অন্যান্য মোসুল ছাড়া এটি আর কিছুকেই ভয় পেত না।"},{"kind":"audi