{"src":"tl","tgt":"en","rate":24000,"room_opened_ms_before":1500,"err":"","clip_ms":315800,"events":[{"kind":"hello","type":"hello","lang":"en","src":"tl","rate":24000,"mode":"utterance","edition":"nonprofit","context":true},{"kind":"input","t":8619.204661,"text":"Ang zona ng Schengen ay tumatakbo gayon pa man sa paraan."},{"kind":"text","t":9022.425656,"text":"The Schengen zone is still running in a way."},{"kind":"audio","t":9127.39162,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":9134.527004,"samples":32768,"rate":24000,"on":0,"off":1150},{"kind":"audio","t":9135.135364,"samples":10064,"rate":24000},{"kind":"input","t":12833.575784,"text":"Kagaya ng isang bansa sa aspetong ito."},{"kind":"text","t":13203.402242,"text":"Like a single country in this aspect."},{"kind":"audio","t":13301.468498,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":13306.087852999999,"samples":32768,"rate":24000,"on":0,"off":1140},{"kind":"audio","t":13306.549706,"samples":7664,"rate":24000},{"kind":"input","t":21789.846916,"text":"matatagpuan sa tuktok ng isa sa mga bundok sa hilaga ng Mecca."},{"kind":"text","t":22329.377536,"text":"located at the top of one of the mountains north of Mecca."},{"kind":"audio","t":22428.705611,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":22435.616639,"samples":32768,"rate":24000,"on":0,"off":1280},{"kind":"audio","t":22442.643964,"samples":32768,"rate":24000,"on":70,"off":890},{"kind":"audio","t":22442.942879,"samples":3696,"rate":24000},{"kind":"input","t":26828.493169999998,"text":"Ang Kuweba ay lubos ang hiwalay sa iba pang panig na mundo."},{"kind":"text","t":27348.713634,"text":"The Cave is completely isolated from the rest of the world."},{"kind":"audio","t":27456.078519,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":27461.618469,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":27466.665506999998,"samples":32768,"rate":24000,"on":0,"off":870},{"kind":"audio","t":27466.812814,"samples":1896,"rate":24000},{"kind":"input","t":37540.733848,"text":"Ang mga tao ay nagsusulat na ngayon ng mga mensahe sa mga screen ng computer."},{"kind":"text","t":37954.571101,"text":"People are now writing messages on computer screens."},{"kind":"audio","t":38059.987377000005,"samples":32768,"rate":24000,"on":380,"off":1220},{"kind":"audio","t":38065.35532,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":38070.955609000004,"samples":32768,"rate":24000,"on":0,"off":980},{"kind":"audio","t":38071.25511400001,"samples":4296,"rate":24000},{"kind":"input","t":42638.995913000006,"text":"na hindi kailanman kakailangan ng lumapit sa pantasa."},{"kind":"text","t":43121.768306000005,"text":"that will never need to go near a sharpener."},{"kind":"audio","t":43220.511041000005,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":43225.824074000004,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":43227.684894000005,"samples":16664,"rate":24000,"on":0,"off":50},{"kind":"input","t":58853.352752000006,"text":"Ang mga manlalakbay na papunta sa mga bansang may malaking pagbubuwis kung minsan ay maaaring makatipid ng malaki-laking halaga ng salapid."},{"kind":"text","t":59518.524379,"text":"Travelers heading to countries with high taxes can sometimes save significant amounts of money."},{"kind":"audio","t":59626.950986,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":59629.988437,"samples":32768,"rate":24000,"on":40,"off":1360},{"kind":"audio","t":59633.51011,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59637.351057,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":59641.74896600001,"samples":32768,"rate":24000,"on":0,"off":860},{"kind":"audio","t":59642.033671000005,"samples":2960,"rate":24000},{"kind":"input","t":63895.989031,"text":"lalo na sa mga produktong tulad ng mga inuming may alkohol at sigarilyo."},{"kind":"text","t":64351.78099200001,"text":"especially on products such as alcoholic drinks and cigarettes."},{"kind":"audio","t":64453.653736,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":64458.958040000005,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":64464.28987300001,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":64466.345550000005,"samples":16896,"rate":24000,"on":30,"off":140},{"kind":"input","t":75054.51075599999,"text":"Binubuo na mga halaman ang kanilang kinakain na galing sa araw gamit ang photosintesis."},{"kind":"text","t":75546.562609,"text":"Plants create their own food from the sun using photosynthesis."},{"kind":"audio","t":75652.80840699999,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":75657.961845,"samples":32768,"rate":24000,"on":0,"off":1170},{"kind":"audio","t":75663.246411,"samples":32768,"rate":24000,"on":140,"off":1360},{"kind":"audio","t":75665.138771,"samples":16296,"rate":24000,"on":0,"off":110},{"kind":"input","t":78420.13885,"text":"naghahandog rin sila ng lilim."},{"kind":"text","t":78694.144176,"text":"They also provide shade."},{"kind":"audio","t":78786.762781,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":78787.496499,"samples":22432,"rate":24000,"on":0,"off":390},{"kind":"input","t":87428.981741,"text":"Nasunda ng ospital ang protokol para sa pagkontrol sa impeksyon."},{"kind":"text","t":87803.84107,"text":"The hospital followed the infection control protocol."},{"kind":"audio","t":87904.001945,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":87910.58765999999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":87916.372198,"samples":31064,"rate":24000,"on":0,"off":680},{"kind":"input","t":95755.12389599999,"text":"Kasama ang paghihiwalay ng pasyente sa iba upang maiwasan ang posibleng pagkahawa ng iba."},{"kind":"text","t":96375.73529099999,"text":"This included isolating the patient from others to prevent the possible spread of infection."},{"kind":"audio","t":96492.990303,"samples":32768,"rate":24000,"on":400,"off":1240},{"kind":"audio","t":96496.17090299999,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":96499.187695,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":96502.56129099999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":96505.094971,"samples":27928,"rate":24000,"on":0,"off":550},{"kind":"input","t":104926.474188,"text":"Karamihan sa trabahong ginawa ay theoretical."},{"kind":"text","t":105303.83739799999,"text":"Most of the work done was theoretical."},{"kind":"audio","t":105412.781723,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":105418.221796,"samples":32768,"rate":24000,"on":0,"off":1130},{"kind":"audio","t":105418.58357,"samples":8264,"rate":24000},{"kind":"input","t":111823.664833,"text":"Ngunit ang programa ay sinulat upang maghikayat ng mga..."},{"kind":"text","t":112197.44217,"text":"But the program was written to encourage..."},{"kind":"audio","t":112314.966818,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":112320.260773,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":112321.162149,"samples":11864,"rate":24000},{"kind":"input","t":117255.91244999999,"text":"ginawang obserbasyon hinggil sa Sagittarius Galaxy."},{"kind":"text","t":117581.640183,"text":"observations made regarding the Sagittarius Galaxy."},{"kind":"audio","t":117688.141706,"samples":32768,"rate":24000,"on":430,"off":1260},{"kind":"audio","t":117694.418696,"samples":32768,"rate":24000,"on":90,"off":1360},{"kind":"audio","t":117701.00876099999,"samples":32768,"rate":24000,"on":0,"off":1130},{"kind":"audio","t":117701.519923,"samples":9096,"rate":24000},{"kind":"input","t":128779.050825,"text":"Ang mga opisyal na lingwahin ng Barcelona ay Katalan at Espanyol. Mga kalahati ang mga gusto magsalita ng Katalan."},{"kind":"text","t":129254.00439999999,"text":"The official languages of Barcelona are Catalan and Spanish. About half of them want to speak Catalan."},{"kind":"audio","t":129357.720678,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":129362.806197,"samples":32768,"rate":24000,"on":0,"off":1050},{"kind":"audio","t":129368.29397,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":129370.597863,"samples":19296,"rate":24000,"on":0,"off":250},{"kind":"audio","t":129442.318861,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":129447.71867499998,"samples":32768,"rate":24000,"on":0,"off":1230},{"kind":"audio","t":129448.53224199999,"samples":11264,"rate":24000},{"kind":"input","t":133585.968022,"text":"Naiintindihan ito ng karamihan at halos ay lahat alam mga Espanyol."},{"kind":"text","t":134148.66676,"text":"Most people understand it, and almost all Spanish people know it."},{"kind":"audio","t":134250.63806599998,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":134255.745714,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":134261.09028899999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":134263.27608399998,"samples":19296,"rate":24000,"on":0,"off":170},{"kind":"input","t":141060.835006,"text":"Sa ilang mga lugar, ang pagpapakulo ng tubig sa loob ng isang minuto ay sapat na."},{"kind":"text","t":141588.243875,"text":"In some areas, boiling water for one minute is sufficient."},{"kind":"audio","t":141694.143779,"samples":32768,"rate":24000,"on":400,"off":1310},{"kind":"audio","t":141699.130009,"samples":32768,"rate":24000,"on":310,"off":1360},{"kind":"audio","t":141704.71103,"samples":32768,"rate":24000,"on":0,"off":1120},{"kind":"audio","t":141705.39856899998,"samples":10296,"rate":24000},{"kind":"input","t":145195.131607,"text":"Sa iba, higit pa sa isang minuto ang kinakailangan."},{"kind":"text","t":145646.241461,"text":"In others, more than one minute is required."},{"kind":"audio","t":145745.200695,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":145750.866455,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":145753.619651,"samples":20264,"rate":24000,"on":0,"off":270},{"kind":"input","t":156717.105969,"text":"Pinakamagandang dignan ang mga halaman kapag nasa natural na kaligiran. Kaya pigilan ang simbuyo na kumuha ng kahit na isa lang na specimen."},{"kind":"text","t":157220.359354,"text":"Plants are best grown in their natural environment. So resist the urge to take even just one specimen."},{"kind":"audio","t":157324.012213,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":157329.322918,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":157332.089214,"samples":22064,"rate":24000,"on":0,"off":340},{"kind":"audio","t":157415.882469,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":157421.332803,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":157425.617144,"samples":30464,"rate":24000,"on":0,"off":670},{"kind":"input","t":166004.188658,"text":"Sa panahon ng 1920s, ang nananay na kaugalian ng karamihan sa mga mamamayan"},{"kind":"text","t":166640.224818,"text":"During the 1920s, the prevailing custom of most citizens"},{"kind":"audio","t":166742.650226,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":166747.823774,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":166753.22862799998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":166756.163041,"samples":22296,"rate":24000,"on":0,"off":390},{"kind":"input","t":170982.042873,"text":"At na mga bansa ay pasipismo at pagbubukod."},{"kind":"text","t":171368.37328,"text":"and countries was pacifism and isolation."},{"kind":"audio","t":171477.727988,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":171483.04622299998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":171485.928797,"samples":22664,"rate":24000,"on":0,"off":310},{"kind":"input","t":178986.993304,"text":"Ang Mosasaurus ay ang pang-nangungunang mandaragit ng"},{"kind":"text","t":179395.387219,"text":"The Mosasaurus was the leading predator of"},{"kind":"audio","t":179499.307454,"samples":32768,"rate":24000,"on":390,"off":1340},{"kind":"audio","t":179504.670868,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":179507.006281,"samples":17264,"rate":24000,"on":0,"off":100},{"kind":"input","t":185770.223673,"text":"kanyang panahon. Kaya wala itong kinatatakutan maliban sa ibang Mosasaurus."},{"kind":"text","t":186392.341594,"text":"its time. That is why it feared nothing except other Mosasaurus."},{"kind":"audio","t":186488.774629,"samples":32768,"rate":24000,"on":380,"off":1100},{"kind":"audio","t":186489.104023,"samples":5032,"rate":24000},{"kind":"audio","t":186579.757779,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":186585.080375,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":186590.754144,"samples":32768,"rate":24000,"on":0,"off":980},{"kind":"audio","t":186591.03867,"samples":4296,"rate":24000},{"kind":"input","t":196803.062806,"text":"Simula ng pagtatatag ng asunsyon noong 1537,"},{"kind":"text","t":197356.595693,"text":"Since the establishment of the assumption in 1537,"},{"kind":"audio","t":197467.87000999998,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":197473.403862,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":197478.830146,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":197480.43031999998,"samples":14496,"rate":24000,"on":0,"off":20},{"kind":"input","t":204093.738466,"text":"Nagawang panatilihin ng Paraguay ang maraming katutubong katangian at pagkakakilanlan nito."},{"kind":"text","t":204683.902393,"text":"Paraguay managed to preserve many of its indigenous characteristics and identity."},{"kind":"audio","t":204791.52675699999,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":204796.891912,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":204802.198408,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":204807.456495,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":204809.347615,"samples":17128,"rate":24000,"on":0,"off":80},{"kind":"input","t":214360.243453,"text":"Ang mga sakit na dala ng baboy ay nalilipat sa mga tao."},{"kind":"text","t":214844.746494,"text":"Diseases carried by pigs can be transmitted to humans."},{"kind":"audio","t":214944.900317,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":214950.142734,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":214955.750905,"samples":32768,"rate":24000,"on":0,"off":980},{"kind":"audio","t":214955.891213,"samples":4296,"rate":24000},{"kind":"input","t":217290.496532,"text":"sa pamamagitan ng mga lamok."},{"kind":"text","t":217493.843299,"text":"through mosquitoes."},{"kind":"audio","t":217586.42038199998,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":217587.102151,"samples":12232,"rate":24000,"on":0,"off":10},{"kind":"input","t":229730.777787,"text":"Karamihan sa mga modernong teleskopyo sa pananaliksik ay napakalalaking pasilidad sa mga liblib na lugar."},{"kind":"text","t":230210.226338,"text":"Most modern research telescopes are massive facilities in remote areas."},{"kind":"audio","t":230320.49083,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":230325.438802,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":230330.813497,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":230336.469267,"samples":32768,"rate":24000,"on":0,"off":1100},{"kind":"audio","t":230336.92733,"samples":7528,"rate":24000},{"kind":"input","t":234127.451354,"text":"na may paborabling atmosferikong kondisyon."},{"kind":"text","t":234403.138125,"text":"with favorable atmospheric conditions."},{"kind":"audio","t":234500.515071,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":234505.367684,"samples":32768,"rate":24000,"on":0,"off":1270},{"kind":"audio","t":234506.133062,"samples":10664,"rate":24000},{"kind":"input","t":245369.766365,"text":"Maaaring hindi inaakala ng mga tao na ang pasensya at pangunawa ay kailangan din."},{"kind":"text","t":245889.452309,"text":"People may not realize that patience and understanding are also needed."},{"kind":"audio","t":245995.932411,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":246001.215627,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":246006.71786,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":246009.784501,"samples":22896,"rate":24000,"on":0,"off":380},{"kind":"input","t":250238.108067,"text":"para sa mga manlalakbay na papauwi."},{"kind":"text","t":250508.548991,"text":"for travelers heading home."},{"kind":"audio","t":250605.13185,"samples":32768,"rate":24000,"on":370,"off":1360},{"kind":"audio","t":250608.523256,"samples":26032,"rate":24000,"on":0,"off":530},{"kind":"input","t":259665.097529,"text":"Kaya nga, maaaring ang maikling tala ay inilagay upang magsilbing magkalamang."},{"kind":"text","t":260358.04364699998,"text":"That is why the short note may have been placed there to serve as a reminder."},{"kind":"audio","t":260457.16707599998,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":260458.80379,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":260460.68196,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":260461.751903,"samples":25296,"rate":24000,"on":0,"off":420},{"kind":"input","t":269230.188753,"text":"Ngunit mayroong napakaraming bagay tungkol sa mga ibon."},{"kind":"text","t":269642.519008,"text":"But there are so many things about birds."},{"kind":"audio","t":269746.138606,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":269751.337143,"samples":32768,"rate":24000,"on":0,"off":1190},{"kind":"audio","t":269751.651058,"samples":8864,"rate":24000},{"kind":"input","t":273040.277657,"text":"Nakahalintulad pa rin ng dinasauro."},{"kind":"text","t":273413.404663,"text":"It is still similar to a dinosaur."},{"kind":"audio","t":273513.32489,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":273520.321649,"samples":32768,"rate":24000,"on":0,"off":980},{"kind":"audio","t":273520.477626,"samples":4664,"rate":24000},{"kind":"input","t":285782.337869,"text":"Halos lahat ng ito ay buhangin na dalampasigan kung saan ligtas ang lumusong sa tubig."},{"kind":"text","t":286471.453137,"text":"Almost all of it is sandy beach where it is safe to wade into the water."},{"kind":"audio","t":286580.582737,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":286585.699126,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":286591.003072,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":286594.621725,"samples":25896,"rate":24000,"on":0,"off":470},{"kind":"input","t":291603.208644,"text":"Ang karamihan ay may lilim na ibinibigay ng mga punong puhutukawa."},{"kind":"text","t":292090.362263,"text":"Most of it is shaded by pohutukawa trees."},{"kind":"audio","t":292190.627154,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":292195.827962,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":292199.10485,"samples":25064,"rate":24000,"on":0,"off":470},{"kind":"input","t":304446.503021,"text":"Si Dubal nakasal at may dalawang may sapat na gulang na anak."},{"kind":"text","t":304897.926547,"text":"Dubal is married and has two adult children."},{"kind":"audio","t":304998.598521,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":305003.766419,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":305005.68394899997,"samples":17864,"rate":24000,"on":0,"off":120},{"kind":"input","t":313064.166681,"text":"ay hindi nag-iwan ng malaking impresyon kay Miller kung kanino ang kwento ay may kaugnayan."},{"kind":"text","t":313725.03289699997,"text":"did not leave a big impression on Miller, to whom the story is related."},{"kind":"audio","t":313828.142143,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":313833.244502,"samples":32768,"rate":24000,"on":0,"off":1200},{"kind":"audio","t":313838.501788,"samples":32768,"rate":24000,"on":240,"off":1360},{"kind":"audio","t":313842.285648,"samples":26496,"rate":24000,"on":0,"off":530},{"kind":"close","t":325805.360646,"code":1005}]}