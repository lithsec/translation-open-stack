6.684041,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":189608.464087,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":189610.31273499998,"samples":32768,"rate":24000,"on":0,"off":970},{"kind":"audio","t":189610.479225,"samples":4160,"rate":24000},{"kind":"audio","t":189648.453232,"samples":32768,"rate":24000,"on":370,"off":1360},{"kind":"audio","t":189648.88651299998,"samples":17032,"rate":24000,"on":0,"off":200},{"kind":"audio","t":189685.613186,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":189686.97205799998,"samples":26632,"rate":24000,"on":50,"off":600},{"kind":"input","t":198299.140872,"text":"unabhängige Nationen oder zu Frankreich gehörig und als luxuriöse Seebäder bekannt."},{"kind":"text","t":198541.35985799998,"text":"Independent nations or part of France, known as luxurious seaside resorts."},{"kind":"audio","t":198588.704477,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":198590.187867,"samples":32768,"rate":24000,"on":0,"off":1140},{"kind":"audio","t":198591.819429,"samples":32768,"rate":24000,"on":190,"off":1360},{"kind":"audio","t":198593.63608899998,"samples":32768,"rate":24000,"on":0,"off":1120},{"kind":"audio","t":198593.816099,"samples":6928,"rate":24000},{"kind":"close","t":208603.025324,"code":1005}]}