s":15000,"rate":24000,"on":320,"off":560},{"kind":"input","t":140987.860159,"text":"Swirl the two dry powers together and then with clean wet hands squeeze them into a ball WOOOOOO"},{"kind":"text","t":141386.947504,"text":"puis, avec des mains propres et mouillées, pressez-les pour former une boule WOOOOOO "},{"kind":"audio","t":141442.577582,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":141443.976165,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":141445.76154,"samples":32768,"rate":24000,"on":10,"off":1210},{"kind":"audio","t":141445.89415900002,"samples":5496,"rate":24000},{"kind":"route","t":141600.769126,"type":"route","src":"en"},{"kind":"route","t":143402.26277200002,"type":"route","src":"en"},{"kind":"input","t":147084.806018,"text":"Cruise passengers are exempted from visa requirements."},{"kind":"text","t":147332.55455300002,"text":"Les passagers de croisière sont exemptés des exigences de visa. "},{"kind":"audio","t":147385.66166800002,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":147387.221303,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":147389.03894600002,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":147389.185096,"samples":9096,"rate":24000},{"kind":"close","t":157402.948505,"code":1005}]}