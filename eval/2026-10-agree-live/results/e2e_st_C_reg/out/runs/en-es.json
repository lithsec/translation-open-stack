una cifra para la "},{"kind":"audio","t":95894.808486,"samples":32768,"rate":24000,"on":180,"off":1360},{"kind":"audio","t":95895.197952,"samples":12832,"rate":24000,"on":0,"off":370},{"kind":"text","t":96808.12616,"text":"recortes, "},{"kind":"audio","t":96857.337294,"samples":24000,"rate":24000,"on":160,"off":870},{"kind":"input","t":97428.10322,"text":"He did not set a figure for the cuts, saying they will be made based on China's economic output."},{"kind":"text","t":97711.644384,"text":"diciendo que se realizarán basándose en la producción económica de China. "},{"kind":"audio","t":97764.752135,"samples":32768,"rate":24000,"on":200,"off":1360},{"kind":"audio","t":97766.23273999999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":97768.047408,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":97768.33482,"samples":10896,"rate":24000,"on":0,"off":260},{"kind":"route","t":99201.438298,"type":"route","src":"en"},{"kind":"text","t":102296.547265,"text":"No existe una definición universal de qué productos manufacturados "},{"kind":"audio","t":102336.381623,"samples":32768,"rate":24000,"on":200,"off":1360},{"kind":"audio","t":102337.798903,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102339.203635,"samples":31064,"rate":24000,"on":0,"off":1120},{"kind":"text","t":105221.778784,"text":"artículos son antigüedades. "},{"kind":"audio","t":105275.566908,"samples":32768,"rate":24000,"on":180,"off":1360},{"kind":"audio","t":105275.861741,"samples":14032,"rate":24000,"on":0,"off":410},{"kind":"input","t":105751.805832,"text":"There is no universal definition for which manufactured items are antiques. Some tax agencies define goods older than 100 years."},{"kind":"text","t":106088.257241,"text":"Algunas agencias tributarias definen los bienes con más de 100 años. "},{"kind":"audio","t":106140.428243,"samples":32768,"rate":24000,"on":200,"off":1360},{"kind":"audio","t":106141.922009,"samples":32768,"rate":24000,"on":0,"