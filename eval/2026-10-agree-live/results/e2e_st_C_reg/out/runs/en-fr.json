{"src":"en","tgt":"fr","rate":24000,"room_opened_ms_before":1500,"err":"","clip_ms":163400,"events":[{"kind":"hello","type":"hello","lang":"fr","src":"en","rate":24000,"mode":"utterance","edition":"nonprofit","context":true},{"kind":"route","t":2101.980471,"type":"route","src":"en"},{"kind":"text","t":5345.571277999999,"text":"Les lions sont les félins les plus sociaux vivant en grands groupes. "},{"kind":"audio","t":5398.542117999999,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":5400.660371999999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":5401.635698,"samples":26864,"rate":24000,"on":0,"off":770},{"kind":"input","t":5803.02251,"text":"Lions are the most social cats living in large groups called prides."},{"kind":"text","t":5898.452176,"text":"appelées troupes. "},{"kind":"audio","t":5948.101573,"samples":32768,"rate":24000,"on":370,"off":1260},{"kind":"audio","t":5948.394794,"samples":5032,"rate":24000},{"kind":"route","t":7802.483295999999,"type":"route","src":"en"},{"kind":"text","t":9975.243267,"text":"Dans le climat chaud du Moyen-Orient, "},{"kind":"audio","t":10012.063137000001,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":10013.233427000001,"samples":27832,"rate":24000,"on":0,"off":760},{"kind":"input","t":11410.209877000001,"text":"In the warm climate of the Middle East, the house was not so important."},{"kind":"text","t":11584.046891,"text":"la maison n'était pas si importante. "},{"kind":"audio","t":11633.559902,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":11634.524322000001,"samples":27232,"rate":24000,"on":0,"off":780},{"kind":"route","t":13101.663095,"type":"route","src":"en"},{"kind":"text","t":16401.583921999998,"text":"Ce sont presque toutes des plages de sable où la baignade est sûre. "},{"kind":"audio","t":16452.730198999998,"samples":32768,"rate":24000,"on":390,"off":1350},{"kind":"audio","t":16454.131105,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":16455.953464,"samples":32768,"rate":24000,"on":0,"off":1060},{"kind":"audio","t":16456.073795,"samples":1896,"rate":24000},{"kind":"input","t":17727.183154,"text":"They are almost all sandy beaches with safe swimming and most have shade provided by"},{"kind":"text","t":17968.096290999998,"text":"et la plupart disposent d'un ombrage offert par "},{"kind":"audio","t":18020.047576999998,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":18021.641383,"samples":32768,"rate":24000,"on":0,"off":1300},{"kind":"audio","t":18021.787132999998,"samples":7664,"rate":24000},{"kind":"route","t":19000.681123,"type":"route","src":"en"},{"kind":"input","t":20569.475732,"text":"Pohican trees."},{"kind":"text","t":20684.305051,"text":"des arbres pohicans. "},{"kind":"audio","t":20732.605289,"samples":32768,"rate":24000,"on":370,"off":1360},{"kind":"audio","t":20732.864718999997,"samples":11032,"rate":24000,"on":0,"off":90},{"kind":"route","t":22501.986264,"type":"route","src":"en"},{"kind":"text","t":23668.948311,"text":"Les troupes sont composées d'un, "},{"kind":"audio","t":23718.273159,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":23718.629985,"samples":18232,"rate":24000,"on":0,"off":400},{"kind":"input","t":26109.436448999997,"text":"Brides are made up of one of two three related adult males along with us"},{"kind":"text","t":26314.476499,"text":"de deux ou trois mâles adultes apparentés ainsi que nous "},{"kind":"audio","t":26353.451329,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":26355.200138,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":26355.521941,"samples":17264,"rate":24000,"on":0,"off":350},{"kind":"route","t":27801.367806,"type":"route","src":"en"},{"kind":"text","t":31046.084926,"text":"Les enfants sauvages ont pu subir des maltraitances graves. "},{"kind":"audio","t":31097.564423,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":31099.27855,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":31101.175230999997,"samples":32264,"rate":24000,"on":0,"off":960},{"kind":"input","t":32637.480501,"text":"Feral children may have experienced severe child abuse or trauma before being abandoned or running away."},{"kind":"text","t":32957.365402999996,"text":"ou un traumatisme avant d'être abandonnés ou de s'enfuir. "},{"kind":"audio","t":32996.190117,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":32997.609620999996,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":32998.681231999995,"samples":26264,"rate":24000,"on":0,"off":700},{"kind":"route","t":34701.260726,"type":"route","src":"en"},{"kind":"input","t":38526.591474,"text":"Scottport Bus 403 traverse regularly to Centra stopping at Cabo de Roca."},{"kind":"text","t":38899.042618,"text":"Le bus 403 de Scottport dessert régulièrement Centra avec un arrêt à Cabo de Roca. "},{"kind":"audio","t":38955.674700999996,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":38957.169108,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":38958.781271,"samples":32768,"rate":24000,"on":0,"off":1290},{"kind":"audio","t":38960.523691,"samples":32768,"rate":24000,"on":130,"off":1360},{"kind":"audio","t":38960.988449,"samples":16528,"rate":24000,"on":0,"off":290},{"kind":"route","t":40702.052636,"type":"route","src":"en"},{"kind":"text","t":42893.90002,"text":"Pour profiter des meilleures vues de Hong Kong, "},{"kind":"audio","t":42930.529394,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":42931.931462,"samples":32768,"rate":24000,"on":0,"off":1040},{"kind":"audio","t":42932.106154,"samples":1064,"rate":24000},{"kind":"text","t":44882.957927999996,"text":"quittez l'île et dirigez-vous vers Kowloon "},{"kind":"audio","t":44932.631761,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":44933.929922999996,"samples":32768,"rate":24000,"on":0,"off":1010},{"kind":"audio","t":44934.031155,"samples":464,"rate":24000},{"kind":"input","t":45857.720456999996,"text":"To get the best views of Hong Kong, leave the island and head for the Kowloon waterfront opposite."},{"kind":"text","t":46034.778543,"text":"le front de mer d'en face. "},{"kind":"audio","t":46071.100705,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":46071.432143,"samples":18832,"rate":24000,"on":0,"off":440},{"kind":"route","t":47501.559869,"type":"route","src":"en"},{"kind":"text","t":50809.788454,"text":"Les points de vue d'Aristote étaient acceptés sur toutes les questions scientifiques, "},{"kind":"audio","t":50863.617193,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":50865.196087,"samples":32768,"rate":24000,"on":0,"off":1290},{"kind":"audio","t":50866.950214,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":50867.63305,"samples":21096,"rate":24000,"on":0,"off":530},{"kind":"input","t":51212.929423,"text":"Accepted were Aristotle's views on all matters of science, including physiology."},{"kind":"text","t":51342.392411,"text":"y compris la physiologie. "},{"kind":"audio","t":51391.386843,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":51391.858481999996,"samples":17632,"rate":24000,"on":0,"off":350},{"kind":"route","t":53201.884697,"type":"route","src":"en"},{"kind":"text","t":58426.670561,"text":"L'Australien Mitchell Gowrie a terminé 11e chez les hommes "},{"kind":"audio","t":58478.630161,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":58480.078828,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":58480.560302,"samples":21464,"rate":24000,"on":0,"off":480},{"kind":"input","t":61228.649758,"text":"Australia's Mitchell Gowrie finished 11th in the men's standing Super G Chet's competitor."},{"kind":"text","t":61375.87689,"text":"dans la compétition de Super G. "},{"kind":"audio","t":61426.528032,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":61427.550319,"samples":28432,"rate":24000,"on":0,"off":790},{"kind":"route","t":62002.021233,"type":"route","src":"en"},{"kind":"input","t":67101.305505,"text":"Ulrich Joklin finished 16th in the men's sitting Super G."},{"kind":"text","t":67441.69504199999,"text":"Ulrich Joklin a terminé 16e dans la compétition de Super G hommes assis. "},{"kind":"audio","t":67495.919125,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":67497.222925,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":67499.005024,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":67500.183365,"samples":26496,"rate":24000,"on":0,"off":710},{"kind":"route","t":69301.703073,"type":"route","src":"en"},{"kind":"text","t":71479.42986999999,"text":"La ville contraste fortement avec le reste du "},{"kind":"audio","t":71517.038776,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":71518.407354,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":71518.558581,"samples":10664,"rate":24000,"on":0,"off":90},{"kind":"text","t":73448.420361,"text":"pays car elle est plus d'un style arabe "},{"kind":"audio","t":73498.612734,"samples":32768,"rate":24000,"on":400,"off":1350},{"kind":"audio","t":73499.320848,"samples":25432,"rate":24000,"on":0,"off":680},{"kind":"input","t":73777.05764099999,"text":"The city is in stark contrast to the rest of the country's cities because it is more of an Arabic flair than of an Arabic flair."},{"kind":"text","t":73859.838183,"text":"allure. "},{"kind":"audio","t":73906.778937,"samples":31800,"rate":24000,"on":380,"off":960},{"kind":"route","t":77401.26016,"type":"route","src":"en"},{"kind":"text","t":80444.63348599999,"text":"De plus, après la révolution, "},{"kind":"audio","t":80493.616461,"samples":32768,"rate":24000,"on":370,"off":1360},{"kind":"audio","t":80494.253148,"samples":21832,"rate":24000,"on":0,"off":530},{"kind":"text","t":81560.543128,"text":"les occupants étaient ouverts à tous les candidats masculins, "},{"kind":"audio","t":81613.244843,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":81614.60483699999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":81615.513964,"samples":23864,"rate":24000,"on":0,"off":600},{"kind":"input","t":84753.28730899999,"text":"Also, after revolution, occupants were open to all male applicants, allowing the most ambitious and successful to succeed."},{"kind":"text","t":85027.591361,"text":"permettant aux plus ambitieux et aux plus performants de réussir. "},{"kind":"audio","t":85084.489184,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":85086.027156,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":85087.352358,"samples":29864,"rate":24000,"on":0,"off":860},{"kind":"route","t":86901.836385,"type":"route","src":"en"},{"kind":"text","t":90151.573671,"text":"La bombe à fusion repose sur le principe qu'il faut "},{"kind":"audio","t":90188.914885,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":90190.415221,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":90190.82053,"samples":16064,"rate":24000,"on":0,"off":300},{"kind":"text","t":92099.569281,"text":"de l'énergie pour assembler un noyau comportant de nombreux protons "},{"kind":"audio","t":92151.322731,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":92152.86360699999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":92154.389982,"samples":32768,"rate":24000,"on":0,"off":1040},{"kind":"audio","t":92154.539276,"samples":1296,"rate":24000},{"kind":"input","t":92345.211898,"text":"The fission bomb works on the principle that it takes energy to put together a nucleus with many protons and neutrons."},{"kind":"text","t":92444.761148,"text":"et des neutrons. "},{"kind":"audio","t":92496.460896,"samples":32768,"rate":24000,"on":380,"off":1210},{"kind":"audio","t":92496.57266399999,"samples":4432,"rate":24000},{"kind":"route","t":93702.165824,"type":"route","src":"en"},{"kind":"text","t":95898.486173,"text":"Il n'a pas fixé de montant pour le "},{"kind":"audio","t":95947.348476,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":95948.069309,"samples":24832,"rate":24000,"on":0,"off":680},{"kind":"text","t":96802.748702,"text":"coupes, "},{"kind":"audio","t":96849.82165499999,"samples":27000,"rate":24000,"on":380,"off":890},{"kind":"input","t":97428.735478,"text":"He did not set a figure for the cuts, saying they will be made based on China's economic output."},{"kind":"text","t":97744.013025,"text":"déclarant qu'elles seront effectuées en fonction de la production économique de la Chine. "},{"kind":"audio","t":97799.139795,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":97800.516725,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":97802.315449,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":97803.835253,"samples":32496,"rate":24000,"on":0,"off":990},{"kind":"route","t":99201.435361,"type":"route","src":"en"},{"kind":"text","t":102368.343183,"text":"Il n'existe pas de définition universelle de ce qui est fabriqué "},{"kind":"audio","t":102407.406967,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":102409.240122,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":102410.862852,"samples":32768,"rate":24000,"on":0,"off":1210},{"kind":"audio","t":102410.97507,"samples":5496,"rate":24000},{"kind":"text","t":105201.563023,"text":"articles sont des antiquités. "},{"kind":"audio","t":105236.60810499999,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":105237.04216699999,"samples":21832,"rate":24000,"on":0,"off":520},{"kind":"input","t":105761.984587,"text":"There is no universal definition for which manufactured items are antiques. Some tax agencies define goods older than 100 years."},{"kind":"text","t":106062.313061,"text":"Certaines administrations fiscales définissent les biens de plus de 100 ans. "},{"kind":"audio","t":106102.356747,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":106103.917233,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106105.72790499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106106.148588,"samples":15696,"rate":24000,"on":0,"off":250},{"kind":"route","t":108000.62772799999,"type":"route","src":"en"},{"kind":"text","t":113133.11278,"text":"Dans l'archipel et les lacs, vous ne "},{"kind":"audio","t":113182.840174,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":113183.300666,"samples":23632,"rate":24000,"on":0,"off":700},{"kind":"input","t":114074.82776,"text":"In the archipelago and lakes you do not necessarily need a yacht"},{"kind":"text","t":114222.039739,"text":"avez nécessairement besoin d'un yacht "},{"kind":"audio","t":114271.416946,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":114272.335808,"samples":26632,"rate":24000,"on":0,"off":750},{"kind":"route","t":116901.620238,"type":"route","src":"en"},{"kind":"text","t":120081.037325,"text":"Le rapport d'aspect de ce format, "},{"kind":"audio","t":120130.870117,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":120131.723019,"samples":29032,"rate":24000,"on":0,"off":810},{"kind":"text","t":122180.049132,"text":"en divisant par 12 pour obtenir le rapport en nombres entiers le plus simple, "},{"kind":"audio","t":122234.91471,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":122236.346302,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":122238.1009,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":122238.77114699999,"samples":19896,"rate":24000,"on":0,"off":450},{"kind":"input","t":123567.645602,"text":"The aspect ratio of this format, dividing by 12 to obtain the simplest whole number ratio, is therefore said to be 3 to 2."},{"kind":"text","t":123783.189242,"text":"est donc dit être de 3 pour 2. "},{"kind":"audio","t":123831.897964,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":123832.441681,"samples":23032,"rate":24000,"on":0,"off":580},{"kind":"route","t":125801.584401,"type":"route","src":"en"},{"kind":"text","t":128956.981029,"text":"Elle est renommée pour être un épicentre du luxe. "},{"kind":"audio","t":128998.808647,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":129000.520681,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":129000.64648,"samples":7064,"rate":24000},{"kind":"input","t":131841.584181,"text":"It's renowned for being an epicenter of luxury began in about 400 AD and lasted up a"},{"kind":"text","t":132213.252368,"text":"a commencé vers 400 apr. J.-C. et a duré jusqu'à "},{"kind":"audio","t":132251.840507,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":132252.178675,"samples":23032,"rate":24000,"on":0,"off":600},{"kind":"audio","t":132285.518874,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":132286.17619199998,"samples":20632,"rate":24000,"on":0,"off":500},{"kind":"route","t":132800.874472,"type":"route","src":"en"},{"kind":"text","t":135905.365655,"text":"environ 1100 apr. J.-C. "},{"kind":"audio","t":135959.643499,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":135959.942348,"samples":14632,"rate":24000,"on":0,"off":260},{"kind":"audio","t":135994.109481,"samples":32768,"rate":24000,"on":370,"off":1070},{"kind":"audio","t":135994.240678,"samples":832,"rate":24000},{"kind":"input","t":136073.468729,"text":"until about 1100 AD."},{"kind":"route","t":138201.336104,"type":"route","src":"en"},{"kind":"text","t":141534.113012,"text":"les politiques d'annulation varient, mais depuis la fin mars, la plupart "},{"kind":"audio","t":141590.082159,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":141591.70592,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":141593.517964,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":141593.654289,"samples":10296,"rate":24000,"on":0,"off":80},{"kind":"text","t":145561.378543,"text":"les politiques d'annulation liées au coronavirus ne s'étendent pas jusqu'en juillet 2020 "},{"kind":"audio","t":145617.293348,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":145618.7917,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":145620.600659,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":145622.491552,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":145622.602378,"samples":8128,"rate":24000},{"kind":"input","t":145772.535699,"text":"Cancellation policies vary but as of late March most coronavirus based cancellation policies don't extend to July 2020 when the Olympics"},{"kind":"text","t":145922.655499,"text":"quand auront lieu les Jeux olympiques "},{"kind":"audio","t":145973.058949,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":145973.547443,"samples":22432,"rate":24000,"on":0,"off":570},{"kind":"route","t":148501.932214,"type":"route","src":"en"},{"kind":"text","t":151772.654747,"text":"Mélangez les deux poudres sèches ensemble, puis avec "},{"kind":"audio","t":151811.167893,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":151812.892365,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":151813.443203,"samples":17864,"rate":24000,"on":0,"off":390},{"kind":"text","t":154711.186158,"text":"mains propres et mouillées, pressez-les pour former une boule "},{"kind":"audio","t":154763.458938,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":154765.301949,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":154765.638735,"samples":15464,"rate":24000,"on":0,"off":290},{"kind":"input","t":154937.396072,"text":"Swirl the two dry powers together and then with clean wet hands squeeze them into a ball"},{"kind":"route","t":157901.487908,"type":"route","src":"en"},{"kind":"text","t":161220.91733,"text":"Les croisières à Saint-Pétersbourg incluent du temps en ville. "},{"kind":"audio","t":161272.506333,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":161274.215742,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":161275.134453,"samples":22664,"rate":24000,"on":0,"off":570},{"kind":"input","t":162240.447288,"text":"St. Petersburg cruises include time in town. Cruise passengers are exempted from visa requirements."},{"kind":"text","t":162513.709063,"text":"Les passagers de croisière sont exemptés des formalités de visa. "},{"kind":"audio","t":162566.511149,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":162568.04973199998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":162569.803258,"samples":32768,"rate":24000,"on":60,"off":1300},{"kind":"audio","t":162569.974095,"samples":7896,"rate":24000},{"kind":"close","t":173503.284934,"code":1005}]}