{"src":"es","tgt":"en","rate":24000,"room_opened_ms_before":1500,"err":"","clip_ms":187000,"events":[{"kind":"hello","type":"hello","lang":"en","src":"es","rate":24000,"mode":"utterance","edition":"nonprofit","context":true},{"kind":"route","t":2102.462856,"type":"route","src":"es"},{"kind":"text","t":5287.609965,"text":"Lions are the most social felines. "},{"kind":"audio","t":5337.750854,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":5339.352522,"samples":32768,"rate":24000,"on":0,"off":1010},{"kind":"audio","t":5340.004081,"samples":5264,"rate":24000},{"kind":"text","t":8240.908402,"text":"and they spend their lives in large groups "},{"kind":"audio","t":8277.629834,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":8279.194016,"samples":32768,"rate":24000,"on":0,"off":1090},{"kind":"audio","t":8280.046436999999,"samples":5264,"rate":24000},{"kind":"input","t":9288.996188,"text":"Los leones son los felinos que más socializan y su vida transcurre dentro de grupos de gran tamaño denominados manadas."},{"kind":"text","t":9372.777627,"text":"called prides. "},{"kind":"audio","t":9424.362066,"samples":32768,"rate":24000,"on":380,"off":1250},{"kind":"audio","t":9424.595506,"samples":8632,"rate":24000},{"kind":"route","t":10601.826794999999,"type":"route","src":"es"},{"kind":"text","t":14315.206248999999,"text":"In the midst of the warm climate of the Middle East, "},{"kind":"audio","t":14367.659785,"samples":32768,"rate":24000,"on":430,"off":1360},{"kind":"audio","t":14369.446421,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":14369.854956,"samples":19064,"rate":24000,"on":0,"off":280},{"kind":"text","t":14840.025814,"text":"the house was of no greater importance. "},{"kind":"audio","t":14889.988754999998,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":14891.613438,"samples":32768,"rate":24000,"on":0,"off":1290},{"kind":"audio","t":14891.794290000002,"samples":11264,"rate":24000},{"kind":"input","t":15072.277161999998,"text":"En medio del cálido clima del Oriente Medio, la casa no era de mayor importancia."},{"kind":"route","t":16301.698208999998,"type":"route","src":"es"},{"kind":"text","t":19473.405131,"text":"Almost all the beaches are sandy with places "},{"kind":"audio","t":19513.311551,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":19515.085789,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":19515.589266,"samples":16664,"rate":24000,"on":0,"off":150},{"kind":"input","t":21776.252992,"text":"Las playas son casi todas de arena con lugares seguros para nadar y en su mayoría tienen árboles."},{"kind":"text","t":21946.163798999998,"text":"safe for swimming and mostly have trees. "},{"kind":"audio","t":21996.089514,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":21997.856301,"samples":32768,"rate":24000,"on":0,"off":1240},{"kind":"audio","t":21997.989381,"samples":10664,"rate":24000},{"kind":"route","t":22801.581259,"type":"route","src":"es"},{"kind":"text","t":25999.580492,"text":"Poutukawa, which provide shaded areas. "},{"kind":"audio","t":26049.918116,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":26051.761968,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":26052.166166,"samples":16064,"rate":24000,"on":10,"off":130},{"kind":"input","t":26150.294496,"text":"Poutukawa, que ofrecen lugares de sombra."},{"kind":"route","t":26901.755103,"type":"route","src":"es"},{"kind":"text","t":30135.455584,"text":"The pods consist of 1 to 3 males. "},{"kind":"audio","t":30186.651188,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":30188.35546,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":30188.697124,"samples":14864,"rate":24000,"on":0,"off":60},{"kind":"input","t":33992.035335,"text":"Las manadas están formadas por uno a tres machos adultos del mismo grupo familiar, unidos con hasta 30 hembras y sus crías."},{"kind":"text","t":34348.084648,"text":"adults from the same family group, joined by up to 30 females and their calves. "},{"kind":"audio","t":34402.379372,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":34404.009853,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":34405.92277,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":34407.784198,"samples":32768,"rate":24000,"on":0,"off":1200},{"kind":"audio","t":34407.968145,"samples":9328,"rate":24000},{"kind":"route","t":34801.616739,"type":"route","src":"es"},{"kind":"text","t":37977.959471,"text":"It is possible that the feral children suffered "},{"kind":"audio","t":38028.397075,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":38030.017322,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":38030.415761,"samples":17264,"rate":24000,"on":0,"off":170},{"kind":"text","t":41965.340086,"text":"traumatic situations or severe child abuse before being "},{"kind":"audio","t":42017.231056,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":42018.798302,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":42020.515613999996,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":42020.804819,"samples":12696,"rate":24000},{"kind":"input","t":42905.153268,"text":"Es posible que los niños salvajes hayan sufrido situaciones traumáticas o abuso infantil grave antes de ser abandonados o de que huyeran."},{"kind":"text","t":43051.999406,"text":"abandoned or that they fled. "},{"kind":"audio","t":43100.961973,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":43101.754544,"samples":24832,"rate":24000,"on":0,"off":470},{"kind":"route","t":43801.067356,"type":"route","src":"es"},{"kind":"text","t":47833.176962,"text":"In Scoturb, "},{"kind":"audio","t":47868.570308,"samples":32768,"rate":24000,"on":400,"off":1260},{"kind":"audio","t":47868.799442,"samples":9832,"rate":24000},{"kind":"text","t":49937.714658,"text":"bus 403 runs regularly to Sintra and stops at "},{"kind":"audio","t":49991.677543,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":49993.398561,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":49995.101491,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":49995.909706,"samples":19296,"rate":24000,"on":0,"off":240},{"kind":"input","t":50190.74608,"text":"En Skoturb, el autobús 403 se dirige con regularidad a Sintra y para en Cabo da Roca."},{"kind":"text","t":50311.384363,"text":"Cabo da Roca. "},{"kind":"audio","t":50347.734567,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":50347.945364,"samples":12832,"rate":24000},{"kind":"route","t":51301.554318,"type":"route","src":"es"},{"kind":"text","t":54446.562717,"text":"The best way to enjoy the best views of Hong Kong is "},{"kind":"audio","t":54499.107811,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":54500.910521,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":54502.103555,"samples":28064,"rate":24000,"on":0,"off":620},{"kind":"text","t":56465.088351,"text":"to leave the island and head to the "},{"kind":"audio","t":56502.210716,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":56503.635668,"samples":32632,"rate":24000,"on":0,"off":780},{"kind":"input","t":56697.02769,"text":"La forma de disfrutar las mejores vistas de Hong Kong es salir de la isla y dirigirse a la ribera de Kowloon."},{"kind":"text","t":56812.480427,"text":"Kowloon waterfront. "},{"kind":"audio","t":56860.637253,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":56861.212878,"samples":18832,"rate":24000,"on":0,"off":250},{"kind":"route","t":57601.060755,"type":"route","src":"es"},{"kind":"text","t":62665.954979,"text":"located opposite. "},{"kind":"audio","t":62718.476918,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":62719.341278,"samples":18232,"rate":24000,"on":0,"off":160},{"kind":"text","t":63845.179414,"text":"Aristotle's thoughts, especially the questions of science, "},{"kind":"audio","t":63899.082549,"samples":32768,"rate":24000,"on":400,"off":1340},{"kind":"audio","t":63900.6062,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":63902.288249,"samples":32768,"rate":24000,"on":0,"off":870},{"kind":"audio","t":63902.454319,"samples":1296,"rate":24000},{"kind":"input","t":65819.489928,"text":"ubicada enfrente. Los pensamientos de Aristóteles, en especial las cuestiones de la ciencia, incluso la psicología, fueron aceptadas."},{"kind":"text","t":65952.483118,"text":"even psychology, were accepted. "},{"kind":"audio","t":66003.042927,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":66004.330813,"samples":32768,"rate":24000,"on":0,"off":860},{"kind":"audio","t":66004.471485,"samples":1064,"rate":24000},{"kind":"route","t":67401.639255,"type":"route","src":"es"},{"kind":"text","t":71518.203693,"text":"Mitchell Gurley, from Australia, "},{"kind":"audio","t":71555.95967,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":71557.335449,"samples":32632,"rate":24000,"on":0,"off":760},{"kind":"text","t":72556.360407,"text":"took eleventh place in the men's category "},{"kind":"audio","t":72606.248446,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":72607.921261,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":72608.215744,"samples":14264,"rate":24000,"on":0,"off":20},{"kind":"input","t":73786.592504,"text":"Mitchell Gurley de Australia obtuvo el undécimo puesto en la categoría masculina de pie del slalom supergigante."},{"kind":"text","t":73939.269329,"text":"of the super-G slalom. "},{"kind":"audio","t":73975.924561,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":73976.573858,"samples":21832,"rate":24000,"on":0,"off":350},{"kind":"route","t":74701.217324,"type":"route","src":"es"},{"kind":"text","t":79877.983161,"text":"The Czech competitor, Oldrik Jelinek, "},{"kind":"audio","t":79916.50842499999,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":79918.178837,"samples":32768,"rate":24000,"on":0,"off":1270},{"kind":"audio","t":79918.4139,"samples":10664,"rate":24000},{"kind":"input","t":80785.79002,"text":"El competidor checo, Oldrik Jelinek, terminó decimosexto en el grupo masculino de sentados."},{"kind":"text","t":80981.377333,"text":"finished sixteenth in the men's sitting category. "},{"kind":"audio","t":81032.72809,"samples":32768,"rate":24000,"on":400,"off":1340},{"kind":"audio","t":81034.173163,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":81034.85604,"samples":20264,"rate":24000,"on":0,"off":240},{"kind":"route","t":82201.195321,"type":"route","src":"es"},{"kind":"text","t":85344.62668,"text":"The city contrasts sharply with the rest of the country, "},{"kind":"audio","t":85395.951729,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":85397.443772,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":85398.94925599999,"samples":31664,"rate":24000,"on":0,"off":740},{"kind":"input","t":87081.96646,"text":"La ciudad contrasta mucho con los restantes del país, ya que posee un estilo más árabe que africano."},{"kind":"text","t":87278.278021,"text":"since it has a more Arabic than African style. "},{"kind":"audio","t":87316.753781,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":87318.486557,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":87318.989473,"samples":17864,"rate":24000,"on":0,"off":140},{"kind":"route","t":88401.319954,"type":"route","src":"es"},{"kind":"text","t":91562.751656,"text":"Likewise, after the revolution, "},{"kind":"audio","t":91612.452634,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":91614.09281,"samples":32768,"rate":24000,"on":20,"off":880},{"kind":"audio","t":91614.214052,"samples":1664,"rate":24000},{"kind":"input","t":93576.242129,"text":"Asimismo, luego de la revolución, los puestos estuvieron abiertos a todos los candidatos masculinos."},{"kind":"text","t":93759.372112,"text":"the positions were open to all male candidates. "},{"kind":"audio","t":93797.032535,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":93798.871951,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":93799.588618,"samples":20264,"rate":24000,"on":0,"off":300},{"kind":"route","t":94301.658849,"type":"route","src":"es"},{"kind":"text","t":98368.839446,"text":"which allowed the most ambitious to succeed "},{"kind":"audio","t":98419.035597,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":98420.944107,"samples":32768,"rate":24000,"on":0,"off":1210},{"kind":"audio","t":98421.115695,"samples":9464,"rate":24000},{"kind":"input","t":98757.861754,"text":"lo que permitió el éxito de los más ambiciosos y prestigiosos."},{"kind":"text","t":98846.084611,"text":"and prestigious. "},{"kind":"audio","t":98893.606051,"samples":32768,"rate":24000,"on":380,"off":1320},{"kind":"audio","t":98893.796437,"samples":10432,"rate":24000},{"kind":"route","t":100101.669326,"type":"route","src":"es"},{"kind":"text","t":103259.314815,"text":"The atomic bomb operates on the principle "},{"kind":"audio","t":103297.971857,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":103299.800496,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":103300.06933,"samples":14864,"rate":24000},{"kind":"text","t":106254.890256,"text":"that energy is required to form a nucleus "},{"kind":"audio","t":106305.728183,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":106307.518475,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":106308.536545,"samples":24464,"rate":24000,"on":30,"off":480},{"kind":"input","t":107503.307465,"text":"La bomba atómica opera en base al principio de que se requiere energía para conformar un núcleo con gran cantidad de protones y neutrones."},{"kind":"text","t":107682.615641,"text":"with a large number of protons and neutrons. "},{"kind":"audio","t":107720.122163,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":107721.90603499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":107722.627971,"samples":20264,"rate":24000,"on":0,"off":290},{"kind":"route","t":109001.466649,"type":"route","src":"es"},{"kind":"text","t":113318.902624,"text":"He did not mention a figure for the cuts and stated that he "},{"kind":"audio","t":113372.516284,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":113374.153616,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113376.16886599999,"samples":32768,"rate":24000,"on":0,"off":920},{"kind":"audio","t":113376.308896,"samples":3696,"rate":24000},{"kind":"input","t":114687.460097,"text":"No mencionó una cifra para los recortes y manifestó que se harán en base a la producción económica de China."},{"kind":"text","t":114901.459532,"text":"will be made based on China's economic production. "},{"kind":"audio","t":114939.748521,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":114941.401937,"samples":32768,"rate":24000,"on":0,"off":1280},{"kind":"audio","t":114942.602833,"samples":28064,"rate":24000,"on":10,"off":540},{"kind":"route","t":115901.645056,"type":"route","src":"es"},{"kind":"text","t":118988.071455,"text":"There is no universal criterion that determines when a "},{"kind":"audio","t":119039.509795,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":119041.18917,"samples":32768,"rate":24000,"on":0,"off":1350},{"kind":"audio","t":119042.659661,"samples":32768,"rate":24000,"on":30,"off":910},{"kind":"audio","t":119042.759391,"samples":3096,"rate":24000},{"kind":"input","t":121279.041398,"text":"No hay un criterio universal que determine cuándo un bien manufacturado puede ser considerado una antigüedad."},{"kind":"text","t":121464.315655,"text":"manufactured good can be considered an antique. "},{"kind":"audio","t":121502.907479,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":121504.558531,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":121506.058156,"samples":31664,"rate":24000,"on":0,"off":750},{"kind":"route","t":122201.610193,"type":"route","src":"es"},{"kind":"text","t":126270.688093,"text":"Some tax agencies have established that objects "},{"kind":"audio","t":126321.851669,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":126323.205414,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":126323.912998,"samples":19664,"rate":24000,"on":0,"off":300},{"kind":"input","t":128071.803883,"text":"Algunas agencias impositivas tienen establecido que los objetos de más de 100 años son antigüedades."},{"kind":"text","t":128268.07968,"text":"over 100 years old are antiques. "},{"kind":"audio","t":128318.936335,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":128320.520286,"samples":32768,"rate":24000,"on":0,"off":1150},{"kind":"audio","t":128320.649861,"samples":7064,"rate":24000},{"kind":"route","t":129301.582698,"type":"route","src":"es"},{"kind":"text","t":132549.03273200002,"text":"A yacht is not always necessary in the archipelagos. "},{"kind":"audio","t":132588.743048,"samples":32768,"rate":24000,"on":420,"off":1320},{"kind":"audio","t":132590.29157600002,"samples":32768,"rate":24000,"on":40,"off":1360},{"kind":"audio","t":132592.06350000002,"samples":32768,"rate":24000,"on":0,"off":970},{"kind":"audio","t":132592.17605900002,"samples":3696,"rate":24000},{"kind":"text","t":135399.811787,"text":"and lakes. "},{"kind":"audio","t":135446.91953500002,"samples":32768,"rate":24000,"on":380,"off":1080},{"kind":"audio","t":135447.03772300002,"samples":3832,"rate":24000},{"kind":"text","t":136422.976851,"text":"That is why it is said that the dimensional relationship "},{"kind":"audio","t":136474.464635,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":136476.88966100002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":136477.95483300003,"samples":26864,"rate":24000,"on":0,"off":520},{"kind":"text","t":139274.11578800002,"text":"of this format, "},{"kind":"audio","t":139322.55174300002,"samples":32768,"rate":24000,"on":400,"off":1300},{"kind":"audio","t":139322.78578500001,"samples":11632,"rate":24000},{"kind":"text","t":140619.93228,"text":"divide by 12 in order to calculate the ratio of "},{"kind":"audio","t":140672.793949,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":140674.37753000003,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":140676.12714000003,"samples":32768,"rate":24000,"on":0,"off":980},{"kind":"audio","t":140676.34692100002,"samples":5496,"rate":24000},{"kind":"input","t":140793.46337,"text":"No siempre se precisa un yate en los archipiélagos y lagos."},{"kind":"route","t":140800.78590900003,"type":"route","src":"es"},{"kind":"text","t":142508.19386600002,"text":"That is why it is said that the dimensional relationship of this format, dividing by 12 in order to calculate the simplest integer ratio, "},{"kind":"audio","t":142570.64138800002,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":142572.303457,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":142574.00091,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":142575.749749,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":142577.488473,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":142579.34327200003,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":142581.133804,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":142581.717111,"samples":17224,"rate":24000,"on":0,"off":90},{"kind":"input","t":143214.580954,"text":"Por ello se dice que la relación dimensional de este formato, dividir por 12 a fin de calcular la razón de números enteros más sencilla, equivale a 3.2."},{"kind":"text","t":143388.60795900002,"text":"is equivalent to 3:2. "},{"kind":"audio","t":143425.885738,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":143427.259403,"samples":29632,"rate":24000,"on":0,"off":680},{"kind":"route","t":144701.99064600002,"type":"route","src":"es"},{"kind":"text","t":147864.167278,"text":"Its reputation for being the epicenter of luxury began approximately in the "},{"kind":"audio","t":147919.87994400001,"samples":32768,"rate":24000,"on":410,"off":1360},{"kind":"audio","t":147921.53664500001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":147922.988879,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":147924.79903000002,"samples":32768,"rate":24000,"on":0,"off":1250},{"kind":"audio","t":147924.95973200002,"samples":13528,"rate":24000},{"kind":"input","t":153306.067084,"text":"Su fama de ser epicentro del lujo comenzó aproximadamente en el 400 a.C. y se extendió hasta aproximadamente 1100 d.C."},{"kind":"text","t":153589.99808400002,"text":"400 BC and extended until approximately 1100 AD. "},{"kind":"audio","t":153645.05944,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":153646.42391200003,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":153648.19956200002,"samples":32768,"rate":24000,"on":0,"off":1310},{"kind":"audio","t":153649.972948,"samples":32768,"rate":24000,"on":20,"off":1350},{"kind":"audio","t":153650.49589400002,"samples":15928,"rate":24000,"on":10,"off":50},{"kind":"route","t":154302.074465,"type":"route","src":"es"},{"kind":"text","t":157400.020244,"text":"There are different types of trip cancellation policies, "},{"kind":"audio","t":157451.375078,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":157453.12517,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":157454.249049,"samples":26264,"rate":24000,"on":0,"off":530},{"kind":"text","t":161397.26157600002,"text":"but since the end of March, "},{"kind":"audio","t":161449.145785,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":161449.69641300003,"samples":21232,"rate":24000,"on":0,"off":370},{"kind":"text","t":162315.02554600002,"text":"the coverage of many of these policies based on "},{"kind":"audio","t":162354.31633,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":162356.113863,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":162356.802819,"samples":20864,"rate":24000,"on":30,"off":320},{"kind":"input","t":165678.080155,"text":"Existen diferentes tipos de pólizas de cancelación de viajes, pero desde finales del marzo, la cobertura de gran parte de estas pólizas basadas en el coronavirus no se extiende hasta julio de 2020."},{"kind":"text","t":165923.534634,"text":"the coronavirus does not extend until July 2020. "},{"kind":"audio","t":165980.40285800002,"samples":32768,"rate":24000,"on":390,"off":1330},{"kind":"audio","t":165982.130715,"samples":32768,"rate":24000,"on":30,"off":1040},{"kind":"audio","t":165983.88150800002,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":165984.374099,"samples":18696,"rate":24000,"on":10,"off":180},{"kind":"route","t":166102.033824,"type":"route","src":"es"},{"kind":"text","t":168275.81509000002,"text":"which is when the Games are scheduled for "},{"kind":"audio","t":168326.765175,"samples":32768,"rate":24000,"on":400,"off":1360},{"kind":"audio","t":168328.211409,"samples":32768,"rate":24000,"on":0,"off":1000},{"kind":"audio","t":168328.3119,"samples":4064,"rate":24000},{"kind":"input","t":168607.15778500002,"text":"que es para cuando están programados los Juegos Olímpicos."},{"kind":"text","t":168696.15733900003,"text":"Olympics. "},{"kind":"audio","t":168744.278721,"samples":32768,"rate":24000,"on":390,"off":1140},{"kind":"audio","t":168744.44167600002,"samples":5632,"rate":24000},{"kind":"route","t":169601.52252700002,"type":"route","src":"es"},{"kind":"text","t":173846.91078500001,"text":"Shake both dry powders together and then do it by hand. "},{"kind":"audio","t":173886.159447,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":173887.815157,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":173889.57495200002,"samples":32768,"rate":24000,"on":0,"off":1020},{"kind":"audio","t":173889.687712,"samples":5496,"rate":24000},{"kind":"input","t":177211.10354600003,"text":"Agite ambos polvos secos juntos y después de hacerlo con las manos higienizadas y húmedas, exprímalos para formar una bola."},{"kind":"text","t":177440.02820200002,"text":"sanitized and damp, squeeze them to form a ball. "},{"kind":"audio","t":177492.32330000002,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":177494.03898900002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":177495.430391,"samples":30464,"rate":24000,"on":0,"off":690},{"kind":"route","t":178201.368113,"type":"route","src":"es"},{"kind":"text","t":181370.68145600002,"text":"During the cruises through Saint Petersburg, [something] is also... "},{"kind":"audio","t":181424.81884300002,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":181426.28829300002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":181428.018985,"samples":32768,"rate":24000,"on":0,"off":1180},{"kind":"audio","t":181428.22628700003,"samples":10896,"rate":24000},{"kind":"text","t":182268.97894700003,"text":"time is spent in the city. "},{"kind":"audio","t":182305.94321400003,"samples":32768,"rate":24000,"on":380,"off":1360},{"kind":"audio","t":182306.56854500002,"samples":22432,"rate":24000,"on":0,"off":380},{"kind":"text","t":185304.45461000002,"text":"Those disembarking are exempt from the requirements "},{"kind":"audio","t":185355.898438,"samples":32768,"rate":24000,"on":400,"off":1310},{"kind":"audio","t":185357.599075,"samples":32768,"rate":24000,"on":0,"off":1330},{"kind":"audio","t":185358.898519,"samples":28664,"rate":24000,"on":0,"off":700},{"kind":"input","t":186642.644245,"text":"Durante los cruceros por San Petersburgo también se pasa tiempo en la ciudad. Se exime a quienes desembarcan de los requerimientos de visado. Consulte términos."},{"kind":"text","t":186795.8397,"text":"for a visa. See terms. "},{"kind":"audio","t":186845.75896500002,"samples":32768,"rate":24000,"on":370,"off":1230},{"kind":"audio","t":186845.992556,"samples":9232,"rate":24000},{"kind":"audio","t":186886.88677200003,"samples":32768,"rate":24000,"on":370,"off":1130},{"kind":"audio","t":186887.095566,"samples":6232,"rate":24000},{"kind":"close","t":197102.20268400002,"code":1005}]}