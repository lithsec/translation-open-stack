:24000,"on":0,"off":1360},{"kind":"audio","t":18194.792481999997,"samples":32768,"rate":24000,"on":0,"off":920},{"kind":"audio","t":18195.105258,"samples":5960,"rate":24000},{"kind":"input","t":20580.214477999998,"text":"Pohican trees."},{"kind":"text","t":20727.212152999997,"text":"ポヒカンという木々。"},{"kind":"audio","t":20768.009858999998,"samples":32768,"rate":24000,"on":280,"off":1360},{"kind":"audio","t":20770.649222,"samples":21232,"rate":24000,"on":0,"off":240},{"kind":"input","t":26123.510668,"text":"Brides are made up of 1 to 3 related adult males along with us"},{"kind":"text","t":26524.799799999997,"text":"花嫁は、私たちと共に、血縁関係にある1〜3匹の成体オスで構成されています。"},{"kind":"audio","t":26584.892965,"samples":32768,"rate":24000,"on":270,"off":1360},{"kind":"audio","t":26589.970744,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":26595.283618999998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":26600.682763999997,"samples":32768,"rate":24000,"on":0,"off":1320},{"kind":"audio","t":26605.929949999998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":26610.097730999998,"samples":25760,"rate":24000,"on":0,"off":350},{"kind":"input","t":32638.465215,"text":"Feral children may have experienced severe child abuse or trauma before being abandoned or running away."},{"kind":"text","t":33138.376372,"text":"野生児は、捨てられたり家を飛び出したりする前に、深刻な児童虐待やトラウマを経験した可能性があります。"},{"kind":"audio","t":33201.686142,"samples":32768,"rate":24000,"on":280,"off":1360},{"kind":"audio","t":33207.350623,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":33212.50796,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":33217.738707000004,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":33223.107021,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":33228.528675,"samples":32768,"rate":24000,"on":0,"off":1300},{"kind":"audio","t":33230.792753,"samples":15192,"rate":24000},{"kind":"input","t":38535.91526900