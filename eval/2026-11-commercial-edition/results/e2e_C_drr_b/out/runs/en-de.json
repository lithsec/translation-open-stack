0},{"kind":"audio","t":106606.796859,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106612.127644,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106615.831781,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106619.00989599999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106622.305109,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":106623.698059,"samples":17554,"rate":24000,"on":0,"off":730},{"kind":"input","t":113187.012884,"text":"The moisture on your hands will react with the outer layers, which will feel funny and form a sort of shell."},{"kind":"text","t":113735.692579,"text":"Die Feuchtigkeit an deinen Händen wird mit den äußeren Schichten reagieren, was sich eigenartig anfühlen wird und eine Art Schale bildet."},{"kind":"audio","t":113986.901379,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113991.78747,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":113996.961816,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114002.22169199999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114007.365299,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114012.61486399999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114017.87778899999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114021.39076899999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114024.711302,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":114027.395484,"samples":26637,"rate":24000,"on":0,"off":1100},{"kind":"input","t":119605.639906,"text":"One bomb exploded outside the Governor's General's office."},{"kind":"text","t":119896.366385,"text":"Eine Bombe explodierte vor dem Büro des Generalgouverneurs."},{"kind":"audio","t":120010.16137799999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120014.907821,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120020.11136699999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120025.209454,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":120029.82301899999,"samples":28866,"rate":24000,"on":0,"off":1200},{"kind":"input","t":125317.07689499999,"text":"The Moroccan Sultan rebuilt the city as Daru i Bayt"},{"kind":"text","t":125667.080282,"text":"Der marokkanische Sultan baute die Stadt als Daru i Bayt wieder auf."},{"kind":"audio","t":125793.402407,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":125798.177679,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":125803.52054299999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":125808.847278,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":125812.997859,"samples":26637,"rate":24000,"on":0,"off":1100},{"kind":"input","t":130441.075751,"text":"and it was given the name Casablanca by Spanish traders who established trading bases."},{"kind":"text","t":130837.973122,"text":"und sie erhielt den Namen Casablanca von spanischen Händlern, die dort Handelsstützpunkte errichteten."},{"kind":"audio","t":131026.630631,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131031.90378600001,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131036.58981,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131041.767506,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131046.72883499999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131052.04874,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131057.258466,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131061.588824,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":131062.98667399999,"samples":17052,"rate":24000,"on":0,"off":710},{"kind":"input","t":142889.36209,"text":"He was greeted by Singapore's Deputy Prime Minister Wong Kan-seng and discussed trade and terrorism issues with the Singapore Prime Minister Lee Hsien Long."},{"kind":"text","t":143638.960919,"text":"Er wurde vom stellvertretenden Premierminister Singapurs, Wong Kan-seng, empfangen und erörterte Handels- und Terrorismusfragen mit dem singapurischen Premierminister Lee Hsien Long."},{"kind":"audio","t":143898.410273,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143903.339323,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143908.942643,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143913.804064,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143918.837242,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143924.754308,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143930.103942,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143933.321967,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143936.567251,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143939.887333,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143943.257236,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143946.4787,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":143947.100201,"samples":10532,"rate":24000,"on":0,"off":430},{"kind":"input","t":154257.427767,"text":"The fission bomb works on the principle that it takes energy to put together a nucleus with many protons and neutrons."},{"kind":"text","t":154773.198419,"text":"Die Fissionsbombe funktioniert nach dem Prinzip, dass Energie benötigt wird, um einen Kern mit vielen Protonen und Neutronen zusammenzusetzen."},{"kind":"audio","t":154981.56257799998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":154982.903539,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":154985.417543,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":154990.966224,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":154996.21908,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":155001.482655,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":155006.79,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":155011.356335,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":155014.68798699998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":155016.311104,"samples":20229,"rate":24000,"on":0,"off":840},{"kind":"input","t":162845.224158,"text":"In the archipelago and lakes you do not necessarily need a yacht"},{"kind":"text","t":163120.616125,"text":"Im Archipel und an den Seen benötigt man nicht unbedingt eine Yacht."},{"kind":"audio","t":163246.310509,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":163251.19357899998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":163256.35869599998,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":163261.589072,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":163266.855517,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":163267.095044,"samples":835,"rate":24000,"on":0,"off":30},{"kind":"close","t":174605.098038,"code":1005}]}