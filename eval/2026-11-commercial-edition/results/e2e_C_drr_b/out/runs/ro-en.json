"t":177767.37227000002,"samples":7664,"rate":24000},{"kind":"input","t":189755.51322300002,"text":"a fost întâmpinat de viceprim-ministrul singaporeului wong kang seng și a purtat discuții cu privire la comerț și terorism cu primul ministru al singaporeului"},{"kind":"text","t":190427.57577,"text":"was welcomed by Singapore’s Deputy Prime Minister Wong Kang Seng and held talks on trade and terrorism with Singapore’s Prime Minister"},{"kind":"audio","t":190482.905353,"samples":32768,"rate":24000,"on":420,"off":1360},{"kind":"audio","t":190487.79567400002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":190493.08133000002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":190498.347906,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":190503.76641,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":190508.882348,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":190514.4283,"samples":32768,"rate":24000,"on":0,"off":1000},{"kind":"audio","t":190514.73011600002,"samples":5824,"rate":24000},{"kind":"input","t":191691.588351,"text":"li sien lung"},{"kind":"text","t":191835.900654,"text":"Li Sien Lung"},{"kind":"audio","t":191872.632118,"samples":32768,"rate":24000,"on":400,"off":1270},{"kind":"audio","t":191873.349928,"samples":9832,"rate":24000},{"kind":"input","t":201194.969863,"text":"bomba de fisiune funcționează conform principiului că este nevoie de energie pentru a asambla un nucleu cu mulți protoni și neutroni"},{"kind":"text","t":201836.673798,"text":"The fission bomb works according to the principle that it takes energy to assemble a nucleus with many protons and neutrons"},{"kind":"audio","t":201890.20769500002,"samples":32768,"rate":24000,"on":390,"off":1360},{"kind":"audio","t":201895.39744300002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":201900.72916800002,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":201905.990724,"samples":3