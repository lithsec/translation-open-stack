6999998,"text":"Also to the north, visit the Great Sanctuary of Our Lady of Fatima Shrine, a place of worldwide"},{"kind":"text","t":24794.552637999997,"text":"Al nan nò tou, vizite Gwo Sanktyè Notre Dame de Fatima, yon kote ki gen enpòtans nan tout mond nan"},{"kind":"audio","t":24848.667783,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":24854.163415,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":24859.562968,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":24865.07965,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":24870.600071999997,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":24875.899477,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":24879.175151,"samples":22741,"rate":24000,"on":0,"off":880},{"kind":"input","t":31550.847612999998,"text":"According to Japan's nuclear agency, radioactive casein and iodine has been identified at the plant."},{"kind":"text","t":32068.281095,"text":"Dapre ajans nikleyè Japon an, yo idantifye kazein akyodinn radyoaktif nan plant la."},{"kind":"audio","t":32121.158767,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":32123.540872999998,"samples":32768,"rate":24000,"on":0,"off":900},{"kind":"audio","t":32126.043268,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":32128.739970000002,"samples":32768,"rate":24000,"on":0,"off":1220},{"kind":"audio","t":32131.291193999998,"samples":32768,"rate":24000,"on":20,"off":1360},{"kind":"audio","t":32133.694519999997,"samples":32768,"rate":24000,"on":0,"off":1070},{"kind":"audio","t":32135.245878,"samples":23698,"rate":24000,"on":80,"off":920},{"kind":"input","t":40584.057035,"text":"The document, according to the leak, will refer to the borders dispute, which Palestine wants based on the borders before the 1967 Mideast War."},{"kind":"text","t":41448.982792,"text":"Dokiman an, dapre fwite a, pral pale de diskit fwontyè a, ke Palestin vle baze sou fwontyè yo te genyen anvan Lagè Mwayen Oryan 1967 la."},{"kind":"audio","t":41509.783292,"samples":32768,"rate":24000,"on":50,"off":820},{"kind":"audio","t":41515.466972,"samples":32768,"rate":24000,"on":170,"off":1180},{"kind":"audio","t":41521.481597,"samples":32768,"rate":24000,"on":620,"off":1340},{"kind":"audio","t":41527.078428,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":41532.946775,"samples":32768,"rate":24000,"on":540,"off":1360},{"kind":"audio","t":41538.139701,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":41541.76271,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":41545.117323,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":41548.299338,"samples":31196,"rate":24000,"on":0,"off":1230},{"kind":"input","t":46944.896703,"text":"The capital of Moldova is Chisinau. The local language is Romanian but Russian."},{"kind":"text","t":47206.552802,"text":"Kapital Moldova se Chisinau. Lang lokal la se Woumanyen men se Ris."},{"kind":"audio","t":47251.9723,"samples":32768,"rate":24000,"on":50,"off":1330},{"kind":"audio","t":47256.330927999996,"samples":26145,"rate":24000,"on":120,"off":1020},{"kind":"audio","t":47279.806506,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":47284.951473,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":47285.989999,"samples":8463,"rate":24000,"on":0,"off":330},{"kind":"input","t":56073.722933,"text":"The other nominations include Best Picture, Director of Cinematography, Costume Design, Film Editing, Original Score,"},{"kind":"text","t":56642.977642,"text":"Lòt nominasyon yo gen ladan yo Pi Bon Film, Direktè Fotografi, Design Kostim, Montaj Film, Mizik Orijinal,"},{"kind":"audio","t":56700.276971,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":56705.447638,"samples":32768,"rate":24000,"on":0,"off":1300},{"kind":"audio","t":56711.229396,"samples":32768,"rate":24000,"on":390,"off":1290},{"kind":"audio","t":56716.6258,"samples":32768,"rate":24000,"on":330,"off":1230},{"kind":"audio","t":56722.659965,"samples":32768,"rate":24000,"on":90,"off":980},{"kind":"audio","t":56728.342704999995,"samples":32768,"rate":24000,"on":200,"off":1360},{"kind":"audio","t":56734.163182,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":56738.051157,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":56741.122184,"samples":29281,"rate":24000,"on":0,"off":1150},{"kind":"input","t":61327.588927,"text":"production design, sound editing, sound mixing, and original screenplay."},{"kind":"text","t":61687.765863,"text":"design pwodiksyon, montaj son, melanj son, ak senaryo orijinal."},{"kind":"audio","t":61747.789174,"samples":32768,"rate":24000,"on":60,"off":1230},{"kind":"audio","t":61749.242122999996,"samples":32768,"rate":24000,"on":290,"off":1260},{"kind":"audio","t":61750.840291,"samples":32768,"rate":24000,"on":230,"off":1360},{"kind":"audio","t":61752.750523999995,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":61753.320906,"samples":13327,"rate":24000,"on":0,"off":480},{"kind":"input","t":67560.236748,"text":"Prior to the arrival of troops, Haiti had not encountered problems related to the disease since the 18th century."},{"kind":"text","t":68217.856877,"text":"Anvan twoup yo te rive, Ayiti pa t konnen pwoblèm ki gen rapò ak maladi sa a depi nan 18yèm syèk la."},{"kind":"audio","t":68279.345937,"samples":32768,"rate":24000,"on":60,"off":1330},{"kind":"audio","t":68284.81006,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":68290.363621,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":68295.665376,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":68301.643742,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":68306.04533,"samples":29408,"rate":24000,"on":0,"off":1150},{"kind":"input","t":75354.043109,"text":"With two years of the end of the war, the former allies were now enemies and the Cold War began."},{"kind":"text","t":76016.118545,"text":"Avèk de ane anvan lagè a te fini, ansyen alye yo te vin lènmi kounye a epi Lagè Frèt la te kòmanse."},{"kind":"audio","t":76077.542636,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":76082.652384,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":76088.243885,"samples":32768,"rate":24000,"on":250,"off":1360},{"kind":"audio","t":76093.67582799999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":76099.728182,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":76105.264784,"samples":32768,"rate":24000,"on":0,"off":1340},{"kind":"audio","t":76107.746419,"samples":16515,"rate":24000,"on":30,"off":620},{"kind":"input","t":85371.340833,"text":"In fact, it is not easy to find at all even if one knew it existed once inside the cave it is a total isolation"},{"kind":"text","t":86054.075667,"text":"An reyalite, li pa fasil ditou pou jwenn li, menm si yon moun ta konnen li te egziste yon fwa anndan grot la se yon izolman total"},{"kind":"audio","t":86109.998136,"samples":32768,"rate":24000,"on":0,"off":1030},{"kind":"audio","t":86115.444929,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":86121.220197,"samples":32768,"rate":24000,"on":0,"off":1090},{"kind":"audio","t":86127.105024,"samples":32768,"rate":24000,"on":350,"off":1300},{"kind":"audio","t":86132.545327,"samples":32768,"rate":24000,"on":30,"off":1360},{"kind":"audio","t":86137.938231,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":86142.333139,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":86145.911788,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":86147.779302,"samples":20657,"rate":24000,"on":0,"off":780},{"kind":"input","t":98251.010844,"text":"Unfortunately, stunning traffic flow is difficult because driver behavior cannot be predicted with 100% certainty."},{"kind":"text","t":98904.052818,"text":"Malerezman, li difisil pou trafik la koule byen paske yo pa ka predi konpòtman chofè yo ak 100% sèten."},{"kind":"audio","t":98952.054629,"samples":32768,"rate":24000,"on":60,"off":1010},{"kind":"audio","t":98953.508929,"samples":32768,"rate":24000,"on":310,"off":1240},{"kind":"audio","t":98954.968948,"samples":32768,"rate":24000,"on":90,"off":970},{"kind":"audio","t":98956.565245,"samples":32768,"rate":24000,"on":100,"off":1360},{"kind":"audio","t":98958.203112,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":98959.81055,"samples":32768,"rate":24000,"on":0,"off":890},{"kind":"audio","t":98960.788336,"samples":22262,"rate":24000,"on":10,"off":860},{"kind":"input","t":108597.177317,"text":"In 2002, Goma was destroyed by lava from the Nyirangogo volcano, which buried most of the town's streets, particularly the town of Goma."},{"kind":"text","t":109409.029665,"text":"Nan ane 2002, lav soti nan volkan Nyirangogo te detwi Goma, sa ki te antere pifò lari nan lavil la, espesyalman lavil Goma a."},{"kind":"audio","t":109464.318163,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":109469.162615,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":109475.346167,"samples":32768,"rate":24000,"on":0,"off":620},{"kind":"audio","t":109481.161785,"samples":32768,"rate":24000,"on":200,"off":1330},{"kind":"audio","t":109486.47512,"samples":32768,"rate":24000,"on":50,"off":1280},{"kind":"audio","t":109492.287727,"samples":32768,"rate":24000,"on":10,"off":1360},{"kind":"audio","t":109497.144159,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":109500.508311,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":109501.362539,"samples":13477,"rate":24000,"on":0,"off":500},{"kind":"input","t":114634.279574,"text":"Rolando Mendoza fired his M16 rifle at the terrorist."},{"kind":"text","t":114949.507975,"text":"Rolando Mendoza te tire fusil M16 li a sou teroris la."},{"kind":"audio","t":114996.975664,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":115002.099892,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":115007.650603,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":115009.417088,"samples":13050,"rate":24000,"on":0,"off":470},{"kind":"input","t":123390.71249,"text":"If you're not used to driving on country roads, keep your wits about you. Steep grades, narrow lanes, and sharp curves predominate."},{"kind":"text","t":123780.482738,"text":"Si ou pa abitye kondwi sou wout pwovens, rete vijilan. Gen mòn ki raide, lari ki etwat, ak koub ki pike ki domine."},{"kind":"audio","t":123830.49259,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":123835.93956299999,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":123841.86959,"samples":32768,"rate":24000,"on":160,"off":900},{"kind":"audio","t":123846.81062,"samples":28615,"rate":24000,"on":190,"off":1130},{"kind":"audio","t":123892.921338,"samples":32768,"rate":24000,"on":60,"off":1280},{"kind":"audio","t":123899.166169,"samples":32768,"rate":24000,"on":690,"off":1230},{"kind":"audio","t":123905.48414,"samples":32768,"rate":24000,"on":240,"off":860},{"kind":"audio","t":123911.85187,"samples":32768,"rate":24000,"on":480,"off":1170},{"kind":"audio","t":123917.686277,"samples":32768,"rate":24000,"on":150,"off":1360},{"kind":"audio","t":123918.25476899999,"samples":7138,"rate":24000,"on":0,"off":220},{"kind":"input","t":132542.918169,"text":"Most modern research telescopes are enormous facilities in remote areas with favorable atmospheric conditions."},{"kind":"text","t":133128.388469,"text":"Pifò teleskòp rechèch modèn yo se gwo enstalasyon ki nan zòn izole ki gen kondisyon atmosferik favorab."},{"kind":"audio","t":133191.099782,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":133192.702749,"samples":32768,"rate":24000,"on":0,"off":1270},{"kind":"audio","t":133194.449735,"samples":32768,"rate":24000,"on":230,"off":1360},{"kind":"audio","t":133196.20748,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":133197.930315,"samples":32768,"rate":24000,"on":0,"off":1160},{"kind":"audio","t":133199.70182,"samples":32768,"rate":24000,"on":200,"off":1290},{"kind":"audio","t":133201.14449,"samples":32768,"rate":24000,"on":140,"off":1060},{"kind":"audio","t":133201.956968,"samples":18468,"rate":24000,"on":40,"off":700},{"kind":"input","t":138536.61897,"text":"The cabbage juice changes color depending on how acidic, basic, alkaline the chemical is."},{"kind":"text","t":139025.909619,"text":"Ji chou foul la chanje koulè selon si pwodwi chimik la asid, bazik, oswa alkalen."},{"kind":"audio","t":139074.517532,"samples":32768,"rate":24000,"on":40,"off":1150},{"kind":"audio","t":139075.506518,"samples":32768,"rate":24000,"on":70,"off":1360},{"kind":"audio","t":139077.166295,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":139078.773422,"samples":32768,"rate":24000,"on":0,"off":1200},{"kind":"audio","t":139080.482797,"samples":32768,"rate":24000,"on":40,"off":1360},{"kind":"audio","t":139081.352895,"samples":21506,"rate":24000,"on":0,"off":820},{"kind":"input","t":145361.055561,"text":"This offers a good opportunity to see the Aurora Borealis as the sky will be dark more or less around the time."},{"kind":"text","t":145928.47805499999,"text":"Sa bay yon bèl okazyon pou w wè Aurora Borealis la paske syèl la ap nwa plis oswa mwens nan lè sa a."},{"kind":"audio","t":145980.748426,"samples":32768,"rate":24000,"on":50,"off":1360},{"kind":"audio","t":145985.898093,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":145991.126859,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":145996.963407,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":146002.645387,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":146008.133229,"samples":32768,"rate":24000,"on":0,"off":1330},{"kind":"audio","t":146012.669245,"samples":27769,"rate":24000,"on":360,"off":1100},{"kind":"input","t":151629.326078,"text":"So it is likely that the notation was added simply as a label."},{"kind":"text","t":151992.345334,"text":"Se anpil chans pou yo te ajoute notasyon an senpleman kòm yon etikèt."},{"kind":"audio","t":152036.205823,"samples":32768,"rate":24000,"on":40,"off":1210},{"kind":"audio","t":152039.216801,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":152040.894457,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":152042.253718,"samples":28375,"rate":24000,"on":0,"off":1110},{"kind":"input","t":158525.12241,"text":"Parisians have a reputation for being egocentric, rude, and arrogant."},{"kind":"text","t":158930.749803,"text":"Moun Pari yo gen repitasyon pou yo egosantrik, maledike, epi awogan."},{"kind":"audio","t":158975.893724,"samples":32768,"rate":24000,"on":60,"off":1360},{"kind":"audio","t":158977.245675,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":158978.753624,"samples":32768,"rate":24000,"on":0,"off":1020},{"kind":"audio","t":158980.46494,"samples":32768,"rate":24000,"on":340,"off":1190},{"kind":"audio","t":158982.343273,"samples":32768,"rate":24000,"on":540,"off":1360},{"kind":"audio","t":158982.677338,"samples":3786,"rate":24000,"on":0,"off":90},{"kind":"input","t":164528.265206,"text":"A curry is a dish based on herbs and spices together with either meat or vegetables."},{"kind":"text","t":164965.639301,"text":"Yon kari se yon plat ki fèt ak zèb ak epis ansanm ak vyann oswa legim."},{"kind":"audio","t":165015.085291,"samples":32768,"rate":24000,"on":60,"off":1250},{"kind":"audio","t":165020.82436,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":165026.760326,"samples":32768,"rate":24000,"on":0,"off":1360},{"kind":"audio","t":165032.257818,"samples":32768,"rate":24000,"on":0,"off":1260},{"kind":"audio","t":165036.420819,"samples":26018,"rate":24000,"on":