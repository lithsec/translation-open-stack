[
 {
  "t": 8.16,
  "type": "final",
  "text": "1940 年 8 月 15 日，盟军攻入法国南部，这次行动被称为“龙骑兵行动”。",
  "start": 0,
  "end": 8.1
 },
 {
  "t": 16.22,
  "type": "final",
  "text": "特朗普与土耳其总统雷杰普塔伊普埃尔多安通话后发表了声明。",
  "start": 8.1,
  "end": 16.19
 },
 {
  "t": 22.86,
  "type": "final",
  "text": "月球的表面由岩石和灰尘组成。月球的外层叫做",
  "start": 16.19,
  "end": 22.62
 },
 {
  "t": 24.34,
  "type": "final",
  "text": "地跳。",
  "start": 22.62,
  "end": 24.22
 },
 {
  "t": 36,
  "type": "final",
  "text": "如果在冬天穿越北波罗的海，要检查客舱的位置，因为在冰面上航行会给那些受影响最严重的人带来非常可怕的噪音。",
  "start": 24.22,
  "end": 35.9
 },
 {
  "t": 46.78,
  "type": "final",
  "text": "他受到了新加坡副总理黄庚成的欢迎，并与新加坡总理李显龙探讨了贸易和恐怖主义问题。",
  "start": 35.9,
  "end": 46.69
 },
 {
  "t": 52.95,
  "type": "final",
  "text": "咖喱饭菜是一道以香草和香料为主的菜肴，并配以肉类或蔬菜。",
  "start": 46.69,
  "end": 52.8
 },
 {
  "t": 61.97,
  "type": "final",
  "text": "这里几乎都是沙滩，游泳很安全，大部分地方都有新西兰圣诞树的树荫。",
  "start": 52.8,
  "end": 61.86
 },
 {
  "t": 69.07,
  "type": "final",
  "text": "山羊似乎是一万年前左右在伊朗的扎格罗斯山脉首次被驯养的。",
  "start": 61.86,
  "end": 69.06
 },
 {
  "t": 80.3,
  "type": "final",
  "text": "中局击球手萨钦坦杜尔卡和拉胡尔德拉维德的表现出色，搭档取得了100跑的成绩。",
  "start": 69.06,
  "end": 80.1
 },
 {
  "t": 86.1,
  "type": "final",
  "text": "消防救援人员最终在晚上 11 点 35 分扑灭了大火。",
  "start": 80.1,
  "end": 86.05
 },
 {
  "t": 94.09,
  "type": "final",
  "text": "福克兰群岛的官方货币是福克兰英镑与英镑等值。",
  "start": 86.05,
  "end": 93.98
 },
 {
  "t": 101.85,
  "type": "final",
  "text": "以虚拟方式分享实地考察，也是回顾行程以及以后班级分享经验的好办法。",
  "start": 93.98,
  "end": 101.57
 },
 {
  "t": 108.76,
  "type": "final",
  "text": "利金斯在医院工作时，开始在业余时间研究早产。",
  "start": 101.57,
  "end": 108.74
 },
 {
  "t": 116.59,
  "type": "final",
  "text": "结果演员在舞台上吸食大麻，剧院本身也鼓励观众一起加入。",
  "start": 108.74,
  "end": 116.42
 },
 {
  "t": 121.57,
  "type": "final",
  "text": "轻粒子是失去了电子的质子。",
  "start": 116.42,
  "end": 121.41
 },
 {
  "t": 125.57,
  "type": "final",
  "text": "因为氢原子由一个质子和一个电子组成。",
  "start": 121.41,
  "end": 125.47
 },
 {
  "t": 132.08,
  "type": "final",
  "text": "此外，在革命之后，官职面向全体男性开放申请。",
  "start": 125.47,
  "end": 132.06
 },
 {
  "t": 136.53,
  "type": "final",
  "text": "这使得最有抱负、最成功之人有机会飞黄腾达。",
  "start": 132.06,
  "end": 136.45
 },
 {
  "t": 144.28,
  "type": "final",
  "text": "场景在金字塔上展示，不同的金字塔被点亮。",
  "start": 136.45,
  "end": 144.16
 },
 {
  "t": 155.47,
  "type": "final",
  "text": "研究该疾病的联合国专家丹尼尔拉塔涅表示，疫情爆发很可能是由维和人员引起的。",
  "start": 144.16,
  "end": 155.33
 },
 {
  "t": 161,
  "type": "final",
  "text": "他把谣言称为“政治碎碎念”和“愚蠢行为”。",
  "start": 155.33,
  "end": 160.93
 },
 {
  "t": 167.96,
  "type": "final",
  "text": "另一方面，冰雪天气在很多国家都十分常见，全年交通也几乎不会中断。",
  "start": 160.93,
  "end": 167.94
 }
]