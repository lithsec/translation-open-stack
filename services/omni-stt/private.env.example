# Private settings for deploy.sh. Copy to private.env (git ignores it) and fill
# in. KEY=value lines only: deploy.sh reads them, never runs them, and a
# variable already set in the environment wins.
#
# Your Google Cloud project and the Artifact Registry repository the images go
# to. A fine-tuned image only ever goes to a private <region>-docker.pkg.dev
# repository; deploy.sh refuses anything else for build-ft and build-voices.
PROJECT=your-project-id
REGION=us-east4
REPO_REGION=us-east4
REPO=omni-stt

# build-ft: the fine-tuned card's name and the PRIVATE gs:// folder holding
# <FT_CARD>.pt and SHA256SUMS. Never a public bucket; never commit the weights.
FT_CARD=omniASR_LLM_300M_yourcard
FT_WEIGHTS=gs://your-private-bucket/models/omniASR_LLM_300M_yourcard

# The service's other credentials, once their Secret Manager secrets exist
# (SECRET=<name> ./deploy.sh secret). Keep them here: every deploy sets the whole
# secret list, and one left out is dropped from the service.
#SIGNING_SECRET=omni-stt-signing-key
#NONPROFIT_SECRET=omni-stt-token-nonprofit
